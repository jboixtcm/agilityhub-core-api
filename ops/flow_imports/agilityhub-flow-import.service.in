[Unit]
Description=Import licensed club Flow results
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1d
StartLimitBurst=3

[Service]
Type=oneshot
User=agilityhub-flow
Group=agilityhub-flow
LoadCredential=api-access:@API_ACCOUNTS@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=@CODE@/libraries.zip
ExecStart=/usr/bin/python3 @CODE@/worker.py --config @STATE@/config.json --weekly --commit
Restart=on-failure
RestartSec=1h
TimeoutStartSec=6h
MemoryMax=192M
CPUQuota=40%
Nice=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=@STATE@
