        en: "Hi [[member_first_name]]! On Saturday the club holds its open day: bring [[dog_name]] and the family (fictional text)."

# E8-T06 (S12, S13): the creditor is fictional and installed only by seed:demo (local and test stacks), never by
# club:apply: the real club enters its own in D11. A fictional creditor identifier with valid check digits and an ES00 IBAN.
# The members are ordinals with no E4–E7 bookings or registrations, keeping their generated fictional names:
# 163 ABONAT/SEPA asks for next month (the pending request), 156 ABONAT/SEPA is inactive this month and the next (fee
# snapshot frozen), 152 ABONAT/cash leaves on the next 31-08, 172 PACK10/SEPA has a 10-session pack expired yesterday and
# its planned leave. Cash members (every third ordinal) give the half-year branch.
billing:
  providers:
    SEPA_XML: {enabled: true, creditorName: Club Agility Exemple, creditorId: ES64ZZZ999999999, iban: ES0021000418450200051332}
  pendingInactivity: 163
  activeInactivity: 156
  leave: 152
  leaveDay: '08-31'
  expiredPack: 172

# E9-T05 (S16; WP-16-G: no Supabase import, fictional test data only, Jordi 30-09, A6): the club's courses, applied once by
# the demo planning run through the S16 services as the club admin (seeds/README.md). Rings by name, levels by code. Each
# `geometries` row is a `PUT /rings/{id}/geometry` body with six markers, A–F, which the Unity export needs; each course model
# is `[type, x, y, rotation]` rows in metres from the bottom-left corner, numbered in order, and `pathLengthM` is course-core's
