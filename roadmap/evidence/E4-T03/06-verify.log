              "required" : [ "client_id" ]
            },
            "urn:agilityhub:grant:handoff" : {
              "optional" : [ "client_secret", "scope" ],
              "required" : [ "client_id", "token" ]
            },
            "urn:agilityhub:grant:magic-link" : {
