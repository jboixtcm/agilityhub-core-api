python3 -c 'import json; t=open('"'"'roadmap/evidence/E11-T06/159-session10-image-scan.log'"'"').read(); d=json.loads(t[t.rfind(chr(10)+'"'"'{'"'"')+1:]); print(json.dumps({k: (v if k in ('"'"'fixableCritical'"'"','"'"'secretRules'"'"','"'"'expiredSuppressions'"'"','"'"'javaPackages'"'"','"'"'vulnerabilities'"'"') else len(v)) for k, v in d.items()}, indent=1)); print('"'"'suppressedCritical ids:'"'"', [s[0] for s in d['"'"'suppressedCritical'"'"']])'
