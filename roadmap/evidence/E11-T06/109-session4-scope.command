python3 -c 'from pathlib import Path; import subprocess; p="roadmap/tasks/E11-T06.md"; current=Path(p).read_text(); original=subprocess.check_output(["git","show","HEAD:"+p],text=True); assert current.split("## Organizer verification",1)[1]==original.split("## Organizer verification",1)[1]; assert Path(p).stat().st_size < 120000; changed=subprocess.check_output(["git","diff","--name-only"],text=True).splitlines(); allowed={p,"roadmap/STATUS.md","roadmap/MESSAGES.md","CHANGELOG.md","roadmap/evidence/E11-T06/progress.json"}; assert set(changed)<=allowed; messages=subprocess.check_output(["git","show","HEAD:roadmap/MESSAGES.md"],text=True); assert Path("roadmap/MESSAGES.md").read_text().startswith(messages); print("PASS: Organizer verification unchanged; MESSAGES append-only; changes limited to E11-T06 handoff; task under 120 KB.")'
