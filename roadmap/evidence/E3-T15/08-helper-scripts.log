# E3-T15 evidence helpers, run from the repository root (they lived in target/, which is not committed).

# ---- target/e3t15-variant.py (used for log 03: HEAD's SignupFollowUpFixesIT + the new «E3-T15» section) ----
"""E3-T15 evidence helper: HEAD's SignupFollowUpFixesIT plus the new E3-T15 section, to run the new tests on HEAD's code."""
import subprocess, pathlib
path = "src/test/java/com/agilityhub/core/clubs/census/api/SignupFollowUpFixesIT.java"
head = subprocess.run(["git", "show", "HEAD:" + path], capture_output=True, text=True, check=True).stdout
fixed = pathlib.Path("target/e3t15-fixed/SignupFollowUpFixesIT.java").read_text()
marker = "    // ---- E3-T15 (review of E3-T12 round 2"
section = fixed[fixed.index(marker):fixed.rindex("}")]
variant = head[:head.rindex("}")] + "\n" + section + "}\n"
pathlib.Path(path).write_text(variant)
print("variant written", len(variant), "chars; E3-T15 section", len(section), "chars")
# output: variant written 42719 chars; E3-T15 section 7681 chars

# ---- target/e3t15-summary.py (used for log 05: totals of the surefire and failsafe reports) ----
"""E3-T15 evidence helper: totals of target/surefire-reports and target/failsafe-reports, plus the classes this task changes."""
import glob, sys
import xml.etree.ElementTree as ET

CHANGED = {"com.agilityhub.core.shared.application.RateLimitsTest", "com.agilityhub.core.clubs.census.api.SignupFollowUpFixesIT"}
for kind in ("surefire", "failsafe"):
    totals = [0, 0, 0, 0]
    rows = []
    for path in sorted(glob.glob(f"target/{kind}-reports/TEST-*.xml")):
        suite = ET.parse(path).getroot()
        counts = [int(suite.get(key, 0)) for key in ("tests", "failures", "errors", "skipped")]
        totals = [a + b for a, b in zip(totals, counts)]
        if suite.get("name") in CHANGED:
            rows.append((suite.get("name"), counts, [case.get("name") for case in suite.findall("testcase")]))
    print(f"{kind}: tests={totals[0]} failures={totals[1]} errors={totals[2]} skipped={totals[3]}")
    for name, counts, cases in rows:
        print(f"  {name}: tests={counts[0]} failures={counts[1]} errors={counts[2]} skipped={counts[3]}")
        for case in sorted(cases):
            if "R_04_20" in case:
                print(f"    - {case}")
sys.exit(0)
