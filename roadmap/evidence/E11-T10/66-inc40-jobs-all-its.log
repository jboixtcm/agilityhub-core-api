scription":"Conflict","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"429":{"description":"Too Many Requests","headers":{"Retry-After":{"description":"Seconds before retrying","schema":{"type":"integer","format":"int32"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"500":{"description":"Internal Server Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"501":{"description":"Not Implemented","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"4XX":{"description":"Client error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"5XX":{"description":"Server error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/v1/week-templates/{id}/bands":{"post":{"tags":["clubs.scheduling"],"summary":"createBand","description":"Roles: ADMIN. Tenant and role guards apply.  Tenant comes from the JWT.","operationId":"createBand","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimeBandCreateRequest"}}},"required":true},"responses":{"201":{"description":"WeekTemplate","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WeekTemplate"}}}},"400":{"description":"VALIDATION_ERROR, INVALID_TIME_RANGE, INVALID_SLOT_GRANULARITY","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"403":{"description":"IMPERSONATION_DENIED","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"NOT_FOUND","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"409":{"description":"BAND_OVERLAP","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"422":{"description":"OUTSIDE_OPENING_HOURS","content":{"applicati