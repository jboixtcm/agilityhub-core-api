  OIDC_ID_WEB_LOGOUT_URI: https://id.example.test/
  OIDC_CLUBS_APP_REDIRECT_URI: https://app.example.test/oidc/callback
  OIDC_CLUBS_APP_LOGOUT_URI: https://app.example.test/
  OIDC_CLUBS_ADMIN_REDIRECT_URI: https://admin.example.test/oidc/callback
  OIDC_CLUBS_ADMIN_LOGOUT_URI: https://admin.example.test/
  CORS_PLATFORM_HOSTS: id.example.test
  SHARED_SCHEDULING_ENABLED: ${CONSUMER_SCHEDULING_ENABLED:-true}
  LOGGING_LEVEL_ROOT: ${CONSUMER_LOG_LEVEL:-INFO}
  SPRING_MAIN_BANNER_MODE: "off"

services:
  mongo:
    image: mongo:7
    ports:
      - "127.0.0.1:${MONGO_PORT:-27017}:27017"
    command: [mongod, --replSet, rs0, --bind_ip_all]
    volumes:
      - mongo-data:/data/db
    healthcheck:
      # Same initialization as docker/mongo-healthcheck.js; no checkout mount needed.
      test:
        - CMD
        - mongosh
        - --quiet
        - --eval
        - >-
          try { rs.status(); } catch (error) {
            if (error.code !== 94) { throw error; }
            rs.initiate({_id:"rs0",members:[{_id:0,host:"mongo:27017"}]});
          }
          if (!db.hello().isWritablePrimary) { quit(1); }
      interval: 5s
      timeout: 5s
      start_period: 30s
      retries: 12

  seed:
    volumes:
      - export-files:/app/exports
      - attachment-files:/app/attachments
    image: ${CORE_IMAGE:-ghcr.io/jboixtcm/agilityhub-core-api:main}
    environment:
      <<: *core-environment
      SEED_PASSWORD: ${SEED_PASSWORD:?Set SEED_PASSWORD in .env.consumer or the environment}
    entrypoint: [/bin/sh, -ec]
    command:
      - |
        java -jar /app/app.jar --core.command=club:apply seeds/club-canic.yaml
        java -jar /app/app.jar --core.command=club:apply seeds/club-minim.yaml
    healthcheck:
      disable: true
    restart: "no"
    depends_on:
      mongo:
        condition: service_healthy

  core:
    image: ${CORE_IMAGE:-ghcr.io/jboixtcm/agilityhub-core-api:main}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8080/api/v1/health || exit 1"]
      interval: 5s
      timeout: 3s
      start_period: 40s
      retries: 12
    environment:
      <<: *core-environment
      SERVER_PORT: 8080
      MAIL_LOCAL_DIRECTORY: /app/mailbox
    ports:
      - "127.0.0.1:${CONSUMER_PORT:-8080}:8080"
    volumes:
      - mailbox:/app/mailbox
      - export-files:/app/exports
      - attachment-files:/app/attachments
    depends_on:
      mongo:
        condition: service_healthy
      seed:
        condition: service_completed_successfully

volumes:
  mongo-data:
  mailbox:
  export-files:
  attachment-files:
"
