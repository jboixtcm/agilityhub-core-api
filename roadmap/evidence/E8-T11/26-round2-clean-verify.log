            "in" : "query",
            "name" : "page",
            "schema" : {
              "default" : 0,
              "format" : "int32",
              "minimum" : 0,
              "type" : "integer"
            }
          }, {
            "description" : "Requested page size: 20, 50, 200 or 1000 (CONVENCIONS_API §4); any other value is 400 INVALID_FILTER.",
            "in" : "query",
            "name" : "size",
            "schema" : {
              "default" : 50,
              "enum" : [ 20, 50, 200, 1000 ],
              "format" : "int32",
              "type" : "integer"
            }
          }, {
            "description" : "Repeat field,asc or field,desc; only x-sortable fields.",
