            "name" : "size",
            "schema" : {
              "default" : 50,
              "enum" : [ 20, 50, 200, 1000 ],
              "format" : "int32",
              "type" : "integer"
            }
          }, {
            "description" : "Repeat field,asc or field,desc; only x-sortable fields.",
            "explode" : true,
