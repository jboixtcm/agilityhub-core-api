                "application/json" : {
                  "schema" : {
                    "$ref" : "#/components/schemas/ListPageAuditEntryListItem"
                  }
                }
              },
              "description" : "ListPage<AuditEntryListItem>; fields selects a sparse projection"
            },
            "400" : {
              "content" : {
