        - {day: WEDNESDAY, start: '20:00', ring: CEN, levels: [B, C], instructor: 1}
    # Template bands cannot overlap: R-06-01's Saturday 17:40 band is left out so 18:30 holds the tournament conflict.
    - name: Dissabtes
      kind: SATURDAY
      bands: ['08:30-09:30', '09:30-10:30', '16:30-17:30', '18:30-19:30']
      classes:
        - {day: SATURDAY, start: '08:30', ring: MUN, levels: [A], instructor: 0}
        - {day: SATURDAY, start: '08:30', ring: CEN, levels: [B, C], instructor: 1}
        - {day: SATURDAY, start: '09:30', ring: CEN, levels: [B, C], instructor: 0}
        - {day: SATURDAY, start: '09:30', ring: CAD, levels: [CAD], instructor: 1}
        - {day: SATURDAY, start: '16:30', ring: CEN, levels: [D, E], instructor: 2}
        - {day: SATURDAY, start: '18:30', ring: CEN, levels: [A, B], instructor: 0}
  # E5-T06: the anchor week is generated (its past days are skipped) and VALIDATED, so screens 03/04 have bookable
  # classes (and the E5 scenario below its data). Week +1 stays GENERATED with DRAFT classes (D4b); week +2 is VALIDATED
  # (D4/D4c/D7). Generation candidates then propose week +3.
  weeks:
    - {offset: 0, weekdays: Setmana A, saturday: Dissabtes, validate: true}
    - {offset: 1, weekdays: Setmana A, saturday: Dissabtes, validate: false}
    - {offset: 2, weekdays: Setmana A, saturday: Dissabtes, validate: true}
  # Added after validation; its instructor already teaches Cadells at the same time -> D4 INSTRUCTOR_DOUBLE_BOOKED warning.
  looseClasses:
    - {week: 2, day: THURSDAY, start: '18:50', end: '19:50', ring: PET, levels: [A], instructor: 1, capacity: 1, description: 'Particular'}
  ringBlocks:
    - {week: 2, day: WEDNESDAY, from: '16:00', to: '18:00', ring: CAR, kind: BLOCK, reason: MAINTENANCE, note: 'manteniment'}
  riskCancellations:
    - {week: 2, day: WEDNESDAY, start: '09:30', ring: CAD}

# Registrants of week +2 booked through the S08 hold + confirmation services (D4 counts) and, since E5-T06, the waiting
