# E5-T06 (S08/S09/S15: screens 03/04/06/29/07/08/24, bin/e5-smoke, web T-08-40). Everything happens on week 0 (the run's
# --week-start) and is consistent at `demoNow`, the instant bin/e5-smoke and the web E2E set the test clock to
# (POST /test/clock). It needs week 0 ahead, so seed:demo applies it only when the anchor is the run's Monday or later
# (club-local; the default anchor always is); an explicit earlier --week-start reports scenario counts of 0. `member` = census ordinal of a seed login
# account (accountEmails order: 5 = member@, 6 = member.2@ … 14 = member.10@); `dog` = that member's first ACTIVE dog of
# the level code; `ring` = catalog short name. Each member acts through the real services «as of» an instant: a class
# booking as of the opening of the class's booking week (+ one second per item), a cancellation at `cancelAt`, free
# training at `trainingAt` (`week: -1` = the week before week 0, so `{week: -1, day: SUNDAY}` is the Sunday of the opening). Non-login registrants are picked like the E4 rows (seed 42,
# member-number order), never the login members. seeds/README.md maps every row to its screen state.
scenario:
  demoNow: {day: MONDAY, time: '07:00'}
  classBookings:
    - {member: 5, dog: E, day: MONDAY, start: '08:30', ring: MUN}                                        # 03 CLASS row; smoke: CANCELLED_LATE under 30 min
    - {member: 6, dog: E, day: MONDAY, start: '08:30', ring: MUN, cancelAt: {day: MONDAY, time: '06:00'}}  # CANCELLED_LATE: «ja feta» on 06
    - {member: 6, dog: E, day: WEDNESDAY, start: '08:30', ring: MUN}                                     # 06: the swappable booking
    - {member: 7, dog: E, day: THURSDAY, start: '20:00', ring: CEN, cancelAt: {week: -1, day: SUNDAY, time: '20:30'}} # CANCELLED in time: 07 green note
    - {member: 7, dog: E, day: MONDAY, start: '08:30', ring: MUN, at: {week: -1, day: SUNDAY, time: '20:40'}}  # LATE_WINDOW at demoNow
    - {member: 7, dog: E, day: MONDAY, start: '09:30', ring: CEN, at: {week: -1, day: SUNDAY, time: '20:41'},
       cancelAt: {day: MONDAY, time: '06:00'}}                                                           # CANCELLED_LATE: 29 informative, 07 yellow note
    - {member: 9, dog: E, day: THURSDAY, start: '17:40', ring: CAR}                                      # frees the WAITLIST_OPEN seat in the smoke
    - {member: 10, dog: E, day: THURSDAY, start: '20:00', ring: CEN}                                     # 2 counted; smoke: in-time cancellation, N-54
  classes:
    - {day: TUESDAY, start: '17:40', ring: CAR, fill: true, waiting: 3}     # WAITLIST_FULL (waitlist.maxPerClass = 3)
    - {day: THURSDAY, start: '17:40', ring: CAR, fill: true, waiting: 1}    # WAITLIST_OPEN
    - {day: THURSDAY, start: '20:00', ring: CEN, booked: 1}                 # with member 10: exactly classes.minDogs
    - {day: TUESDAY, start: '18:50', ring: CEN, booked: 1}                  # P2 on Tuesday 07:30: cancelled, N-17 + N-08a
    - {day: WEDNESDAY, start: '16:30', ring: CEN, booked: 0}                # P2 on Tuesday 07:30: tomorrow, N-16 to the admins
    - {day: TUESDAY, start: '20:00', ring: MUN, booked: 1, riskExempt: true}
  waitlist:
    - {member: 5, dog: E, day: THURSDAY, start: '17:40', ring: CAR}                                      # 03 CLASS_WAITLIST row
  bookingBlocks:
    - {member: 11, reason: 'Quota pendent (fictícia)'}                                                   # 04 NOT_BOOKABLE{BLOCKED} + banner
  training:
    overrides:
      - {member: 5, dog: CAD, freeTraining: true}      # right by override; member 5's E dog has it by level; member 8's CAD dog has none
    bookings:
      - {member: 5, dog: E, trainingAt: {week: -1, day: SUNDAY, time: '20:05'}, day: MONDAY, start: '11:00', ring: MUN}
      - {member: 5, dog: E, trainingAt: {week: -1, day: SUNDAY, time: '20:06'}, day: TUESDAY, start: '11:00', ring: MUN}
      - {member: 6, dog: E, trainingAt: {week: -1, day: SUNDAY, time: '20:07'}, day: MONDAY, start: '11:00', ring: CEN}  # another dog's slot on a capacity-1 ring
  ringBlocks:                                          # created by the instructor (screen 24 and the grids); instructor = demo instructor index
    - {instructor: 0, day: TUESDAY, from: '11:00', to: '12:00', ring: PET, kind: RESERVATION, reason: PRIVATE_CLASS, note: 'Classe particular (fictícia)'}
  activityRegistrations:
    - {member: 5, title: "Torneig d'Estiu 2026"}       # 03 ACTIVITY row
  # E6-T04 (S10 WP-10-G: screens 20-26, D12-D14, bin/e6-smoke). The cast gets invented names through the admin's S03/S05 edits
  # (never the mockups' first names, the T-06-28 guard; seeds/README.md maps each one to the mockup person whose role it plays).
  # `member` = census ordinal (12 = member.8@example.test, a login;
  # 70/75/80/85 each own one level B dog). The logins own CAD and E dogs only, so Rita's CAD dog moves up to A first
  # (`dogLevel` -> `level`). `sheet` = the week-0 class of R-10-02's example (4 booked + 1 waiting on a 5-seat class).
  # `history` = past classes (weeks before 0) that copy it on the same ring, hour, levels and instructor (S06 step), booked at
  # their booking week's opening and marked by the instructor (S08/S10 step; NOTIFIED at noticeAt, in time; each NO_SHOW taken
  # by the next morning's P3 claim). At demoNow Mel's 30 days hold present 6, no-show 1, notified in time 1 (R-10-08: 86 %,
  # 7 classes) and ten free trainings (2.3 a week); the two older weeks give screen 25 its «anul·lada tard» and «cancel·lada
  # pel club» rows. All names and texts are fictional.
  attendance:
    instructor: {index: 0, name: Berta}
    cast:
      - {name: Rita, member: 12, dog: Mel, dogLevel: CAD, level: A}
      - {name: Martí, member: 70, dog: Sorra, level: B}
      - {name: Alba, member: 75, dog: Pinya, level: B}
