ue,"progression":true,"active":true},{"code":"F","name":{"ca":"F","es":"F"},"order":60,"color":"#E8A070","capacity":4,"grantsFreeTraining":true,"progression":true,"active":true},{"code":"G","name":{"ca":"G","es":"G"},"order":70,"color":"#E26A2A","capacity":4,"grantsFreeTraining":true,"progression":true,"active":true},{"code":"TER","name":{"ca":"Teràpia","es":"Terapia"},"order":80,"color":"#C9CDD3","capacity":1,"grantsFreeTraining":false,"progression":false,"active":true},{"code":"PENDENT","name":{"ca":"Pendent","es":"Pendiente"},"order":90,"color":"#9AA0A6","capacity":5,"grantsFreeTraining":false,"progression":false,"active":true}],"rings":[{"name":"Muntanya","shortName":"MUN","color":"#F2B58C","allowsFreeTraining":true,"trainingCapacity":null,"order":0,"active":true},{"name":"Central","shortName":"CEN","color":"#8FCE8F","allowsFreeTraining":true,"trainingCapacity":null,"order":10,"active":true},{"name":"Carretera","shortName":"CAR","color":"#C9CDD3","allowsFreeTraining":true,"trainingCapacity":null,"order":20,"active":true},{"name":"Cadells","shortName":"CAD","color":"#F5D67A","allowsFreeTraining":false,"trainingCapacity":null,"order":30,"active":true},{"name":"Petita","shortName":"PET","color":"#85B8E8","allowsFreeTraining":false,"trainingCapacity":null,"order":40,"active":true}],"instructors":[],"plans":[{"code":"ABONAT","name":{"ca":"Abonat","es":"Abonado"},"type":"MONTHLY","dogsIncluded":1,"entryFee":{"mode":"STANDARD"},"conditions":{"ca":"fins a dues classes per setmana","es":"hasta dos clases por semana"},"showOnSignup":true,"showOnWeb":true,"order":0,"active":true,"billingMode":"MONTHLY_FEE","texts":{"description":{"ca":"Les classes són sempre amb instructor i se'n poden fer fins a dues per setmana. A més hi ha la possibilitat d'entrenament lliure fora d'hores de classe a partir de nivell D amb llicència esportiva.","es":"Las clases son siempre con instructor y puedes hacer hasta dos por semana. Además puedes entrenar libremente fuera del horario de clases a partir del nivel D con licencia deportiva."},"offerLabel":{"ca":"Ofertes si es porta més d'un gos per família","es":"Ofertas por más de un perro por familia"}}},{"code":"ABONAT_FAMILIAR","name":{"ca":"Abonat · 2 gossos (familiar)","es":"Abonado · 2 perros (familiar)"},"type":"MONTHLY","dogsIncluded":2,"entryFee":{"mode":"STANDARD"},"conditions":{"ca":"50% de la quota a partir del 2n gos · pagador únic del grup","es":"50% de la cuota a partir del segundo perro · pagador único del grupo"},"showOnSignup":false,"showOnWeb":true,"order":10,"active":true,"billingMode":"MONTHLY_FEE"},{"code":"PACK6","name":{"ca":"Pack 6","es":"Pack 6"},"type":"PACK","dogsIncluded":1,"entryFee":{"mode":"NONE"},"conditions":{"ca":"només un cop","es":"solo una vez"},"showOnSignup":true,"showOnWeb":true,"order":20,"active":true,"pack":{"sessions":6,"validityMonths":3}},{"code":"PACK10","name":{"ca":"Pack 10","es":"Pack 10"},"type":"PACK","dogsIncluded":1,"entryFee":{"mode":"NONE"},"conditions":{"ca":"només un cop · després 40% dte. en matrícula","es":"solo una vez · después 40% de descuento en matrícula"},"showOnSignup":true,"showOnWeb":true,"order":30,"active":true,"pack":{"sessions":10,"validityMonths":5}},{"code":"TERAPIA","name":{"ca":"Teràpia","es":"Terapia"},"type":"MONTHLY","dogsIncluded":1,"entryFee":{"mode":"PERCENT","percent":50},"conditions":{"ca":"pagament inicial a compte del 50% de l'entrada i quota manteniment en tant no es faci classe en grup","es":"pago inicial a cuenta del 50% de la entrada y cuota de mantenimiento mientras no se hagan clases en grupo"},"showOnSignup":true,"showOnWeb":true,"order":40,"active":true,"billingMode":"MAINTENANCE","texts":{"description":{"ca":"Es poden fer també classes de teràpia individual, combinades amb les classes en grup o com a pas previ. Si la teràpia es combina amb classes en grup, selecciona l'opció d'Abonat o Pack; si d'entrada no faràs classes en grup, selecciona l'opció Teràpia.","es":"También puedes hacer clases de terapia individual