rtName":"CAD","color":"#F5D67A","allowsFreeTraining":false,"order":30,"active":true},{"name":"Petita","shortName":"PET","color":"#85B8E8","allowsFreeTraining":false,"order":40,"active":true}],"faq":[{"category":{"ca":"Convivència al club","es":"Convivencia en el club"},"question":{"ca":"Puc venir amb més gent al club?","es":"¿Puedo venir con más gente al club?"},"answer":{"ca":"[Text pendent — el club l'omplirà des de Paràmetres]","es":"[Text pendent — el club l'omplirà des de Paràmetres]"},"order":0,"active":true,"code":"FAQ_1"},{"category":{"ca":"Convivència al club","es":"Convivencia en el club"},"question":{"ca":"El gos pot anar deslligat pel club?","es":"¿Puede ir el perro suelto por el club?"},"answer":{"ca":"[Text pendent — el club l'omplirà des de Paràmetres]","es":"[Text pendent — el club l'omplirà des de Paràmetres]"},"order":10,"active":true,"code":"FAQ_2"},{"category":{"ca":"Convivència al club","es":"Convivencia en el club"},"question":{"ca":"Què faig si la meva gossa té el zel?","es":"¿Qué hago si mi perra está en celo?"},"answer":{"ca":"[Text pendent — el club l'omplirà des de Paràmetres]","es":"[Text pendent — el club l'omplirà des de Paràmetres]"},"order":20,"active":true,"code":"FAQ_3"},{"category":{"ca":"Reserves de classe","es":"Reservas de clase"},"question":{"ca":"Quantes classes puc reservar i en quin moment?","es":"¿Cuántas clases puedo reservar y cuándo?"},"answer":{"ca":"[Text pendent — el club l'omplirà des de Paràmetres]","es":"[Text pendent — el club l'omplirà des de Paràmetres]"},"order":30,"active":true,"code":"FAQ_4"},{"category":{"ca":"Reserves de classe","es":"Reservas de clase"},"question":{"ca":"Què he de fer si no puc venir a una classe?","es":"¿Qué debo hacer si no puedo venir a una clase?"},"answer":{"ca":"[Text pendent — el club l'omplirà des de Paràmetres]","es":"[Text pendent — el club l'omplirà des de Paràmetres]"},"order":40,"active":true,"code":"FAQ_5"},{"category":{"ca":"Reserves de classe","es":"Reservas de clase"},"question":{"ca":"Què passa si el dia de classe plou?","es":"¿Qué pasa si llueve el día de clase?"},"answer":{"ca":"[Text pendent — el club l'omplirà des de Paràmetres]","es":"[Text pendent — el club l'omplirà des de Paràmetres]"},"order":50,"active":true,"code":"FAQ_6"},{"category":{"ca":"Competicions","es":"Competiciones"},"question":{"ca":"Què cal per poder participar a competicions d'agility?","es":"¿Qué necesito para participar en competiciones de agility?"},"answer":{"ca":"[Text pendent — el club l'omplirà des de Paràmetres]","es":"[Text pendent — el club l'omplirà des de Paràmetres]"},"order":60,"active":true,"code":"FAQ_7"}],"plans":[{"code":"ABONAT","name":{"ca":"Abonat","es":"Abonado"},"type":"MONTHLY","billingMode":"MONTHLY_FEE","dogsIncluded":1,"entryFee":{"mode":"STANDARD"},"conditions":{"ca":"fins a dues classes per setmana","es":"hasta dos clases por semana"},"texts":{"description":{"ca":"Les classes són sempre amb instructor i se'n poden fer fins a dues per setmana. A més hi ha la possibilitat d'entrenament lliure fora d'hores de classe a partir de nivell D amb llicència esportiva.","es":"Las clases son siempre con instructor y puedes hacer hasta dos por semana. Además puedes entrenar libremente fuera del horario de clases a partir del nivel D con licencia deportiva."},"offerLabel":{"ca":"Ofertes si es porta més d'un gos per família","es":"Ofertas por más de un perro por familia"}},"showOnSignup":true,"showOnWeb":true,"order":0,"active":true},{"code":"ABONAT_FAMILIAR","name":{"ca":"Abonat · 2 gossos (familiar)","es":"Abonado · 2 perros (familiar)"},"type":"MONTHLY","billingMode":"MONTHLY_FEE","dogsIncluded":2,"entryFee":{"mode":"STANDARD"},"conditions":{"ca":"50% de la quota a partir del 2n gos · pagador únic del grup","es":"50% de la cuota a partir del segundo perro · pagador único del grupo"},"texts":{},"showOnSignup":false,"showOnWeb":true,"order":10,"active":true},{"code":"PACK6","name":{"ca":"Pack 6","es":"Pack 6"},"type":"PACK","dogsIncluded":1,"entryFee":{"mode":"NONE"},"pack":{"sessions":6,"validityMonths":3},"conditions":{"ca":"Només un cop","es":"Solo una vez"},"texts":{},"showOnSignup":true,"showOnWeb":true,"order":20,"active":true},{"code":"PACK10","name":{"ca":"Pack 10","es":"Pack 10"},"type":"PACK","dogsIncluded":1,"entryFee":{"mode":"NONE"},"pack":{"sessions":10,"validityMonths":5},"conditions":{"ca":"Només un cop · després 40% dte. en matrícula","es":"Solo una vez · después 40% de descuento en matrícula"},"texts":{},"showOnSignup":true,"showOnWeb":true,"order":30,"active":true},{"code":"TERAPIA","name":{"ca":"Teràpia","es":"Terapia"},"type":"MONTHLY","billingMode":"MAINTENANCE","dogsIncluded":1,"entryFee":{"mode":"PERCENT","percent":50},"conditions":{"ca":"pagament inicial a compte del 50% de l'entrada i quota manteniment en tant no es faci classe en grup","es":"pago inicial a cuenta del 50% de la entrada y cuota de mantenimiento mientras no se hagan clases en grupo"},"texts":{"description":{"ca":"Es poden fer també classes de teràpia individual, combinades amb les classes en grup o com a pas previ. Si la teràpia es combina amb classes en grup, selecciona l'opció d'Abonat o Pack; si d'entrada no faràs classes en grup, selecciona l'opció Teràpia.","es":"También puedes hacer clases de terapia individual, combinadas con las clases en grupo o como paso previo. Si combinas terapia y grupo, selecciona Abonado o Pack; si inicialmente no harás clases en grupo, selecciona Terapia."},"priceLabel":{"ca":"condicions i cost segons cada cas","es":"condiciones y coste según cada caso"}},"showOnSignup":true,"showOnWeb":true,"order":40,"active":true},{"code":"COMPETICIO_1","name":{"ca":"Competició 1 gos","es":"Competición 1 perro"},"type":"MONTHLY","billingMode":"MONTHLY_FEE","dogsIncluded":1,"entryFee":{"mode":"STANDARD"},"conditions":{"ca":"competició · 1 gos","es":"competición · 1 perro"},"texts":{},"showOnSignup":false,"showOnWeb":false,"order":50,"active":true}],"prices":[{"concept":"MONTHLY_FEE","amount":{"amountMinor":6000,"currency":"EUR"},"taxPercent":0.0,"validFrom":"2026-01-01","planCode":"ABONAT"},{"concept":"MONTHLY_FEE","amount":{"amountMinor":9000,"currency":"EUR"},"taxPercent":0.0,"validFrom":"2026-01-01","planCode":"ABONAT_FAMILIAR"},{"concept":"PACK","amount":{"amountMinor":13500,"currency":"EUR"},"taxPercent":0.0,"validFrom":"2026-01-01","planCode":"PACK6"},{"concept":"PACK","amount":{"amountMinor":18000,"currency":"EUR"},"taxPercent":0.0,"validFrom":"2026-01-01","planCode":"PACK10"},{"concept":"MAINTENANCE_FEE","amount":{"amountMinor":1000,"currency":"EUR"},"taxPercent":0.0,"validFrom":"2026-01-01","planCode":"TERAPIA"},{"concept":"MONTHLY_FEE","amount":{"amountMinor":4000,"currency":"EUR"},"taxPercent":0.0,"validFrom":"2026-01-01","planCode":"COMPETICIO_1"}],"instructors":[]},"messageTemplates":[],"pages":[{"key":"IMAGE_CONSENT","title":{"ca":"Autorització d'imatge","es":"Autorización de imagen","en":"Image consent"},"body":{"es":"[Text pendent — el club l'omplirà des de Paràmetres]","en":"[Text pendent — el club l'omplirà des de Paràmetres]","ca":"[Text pendent — el club l'omplirà des de Paràmetres]\n\n**Autorització per a la captació i publicació d'imatges**\n\nEn marcar la casella «Autoritzo l'ús de la meva imatge», la persona abonada autoritza expressament **[NOM DEL CLUB]**, NIF [NIF], a captar la seva imatge i veu (i les del seu gos) durant les activitats organitzades pel club, i a reproduir-les, distribuir-les i comunicar-les públicament en els mitjans següents: [pàgina web del club], [perfils del club a xarxes socials: Instagram, Facebook, YouTube…], [cartells i material imprès del club] i [comunicacions als abonats per correu electrònic o app]. La finalitat és exclusivament la difusió de l'activitat esportiva i formativa del club; les imatges no s'utilitzaran amb finalitats comercials de tercers ni es cediran a tercers, llevat de les plataformes on es publiquin (que les tractaran segons les seves pròpies condicions).\n\nL'autorització es concedeix gratuïtament i sense límit territorial, per al temps que la persona sigui abonada i, per a les publicacions ja fetes, sense límit temporal. Es pot **revocar en qualsevol moment** (des de l'app, Perfil → Les meves dades → Consentiments, o escrivint a [CORREU DEL CLUB]); la revocació obliga el club a no fer cap publicació nova i a retirar, quan sigui tècnicament raonable, les publicacions que la persona indiqui expressament.\n\nPer a menors de **14 anys**, l'autorització l'atorga el pare, mare o tutor legal. Base jurídica: consentiment (art. 6.1.a RGPD) i Llei orgànica 1/1982 de protecció civil del dret a l'honor, a la intimitat personal i familiar i a la pròpia imatge. Més informació a la política de privacitat del club.\n"},"active":true},{"key":"PRIVACY","title":{"ca":"Política de privacitat","es":"Política de privacidad","en":"Privacy policy"},"body":{"es":"[Text pendent — el club l'omplirà des de Paràmetres]","en":"[Text pendent — el club l'omplirà des de Paràmetres]","ca":"[Text pendent — el club l'omplirà des de Paràmetres]\n\n# Política de privacitat\n\n## 1. Responsable del tractament\n\n- **[NOM DEL CLUB]** · NIF [NIF DEL CLUB] · [ADREÇA] · [POBLACIÓ] · correu: [CORREU DEL CLUB] · telèfon: [TELÈFON]\n- **Encarregat del tractament** (proveïdor de la plataforma de gestió AgilityHub Clubs): [RAÓ SOCIAL D'AGILITYHUB], que tracta les dades exclusivament per compte del club i segons el contracte de l'art. 28 RGPD.\n\n## 2. Dades que tractem\n\n- Categoria: Identificació i contacte de l'abonat · Dades: nom i cognoms, DNI/NIE o passaport, data de naixement, gènere, adreça postal, fins a dos correus electrònics i dos telèfons · Origen: formulari d'alta / la persona\n- Categoria: Compte d'accés · Dades: correu d'accés al compte AgilityHub, rol al club (alumne, instructor, administrador) · Origen: la persona / el club\n- Categoria: Gossos · Dades: nom, raça, sexe, data de naixement, número de xip, foto, nivell, llicències federatives, documents (cartilla de vacunes, assegurança), notes que vosaltres escriviu per als instructors · Origen: la persona / el club\n- Categoria: Activitat al club · Dades: reserves i assistència a classes, entrenaments lliures i activitats, llista d'espera, tasques i observacions dels instructors, comunicacions rebudes · Origen: ús del servei / els instructors\n- Categoria: Facturació i pagaments · Dades: modalitat, tarifa, rebuts, IBAN i titular del compte (domiciliació), referència de mandat SEPA, o identificador de la vostra targeta al proveïdor de pagaments (mai el número complet), pagaments a l'acte · Origen: la persona / el club / el proveïdor de pagaments\n- Categoria: Grup familiar · Dades: vincle amb altres abonats del mateix grup i qui paga els rebuts · Origen: la persona\n- Categoria: Consentiments · Dades: versió de la política acceptada, autorització d'ús d'imatge (si la doneu), preferències d'avisos · Origen: la persona\n- Categoria: Imatges · Dades: fotos o vídeos en què apareixeu vosaltres o el vostre gos, si heu autoritzat l'ús d'imatge · Origen: el club\n\n## 3. Finalitats i bases jurídiques\n\n- Finalitat: Gestionar la vostra alta com a abonat, les classes, els entrenaments, les activitats, la llista d'espera i l'assistència · Base jurídica: execució del contracte de prestació de serveis del club (art. 6.1.b RGPD)\n- Finalitat: Emetre i cobrar els rebuts (domiciliació SEPA, targeta o efectiu), gestionar impagats i portar la comptabilitat · Base jurídica: execució del contracte i obligació legal (art. 6.1.b i 6.1.c)\n- Finalitat: Enviar-vos avisos sobre les vostres reserves, canvis fets pel club, recordatoris (si els activeu) i comunicats del club, per app, correu electrònic i SMS · Base jurídica: execució del contracte; els comunicats generals del club, interès legítim amb possibilitat d'oposició\n- Finalitat: Seguiment esportiu (tasques, observacions dels instructors, evolució del nivell del gos) · Base jurídica: execució del contracte\n- Finalitat: Publicar fotos o vídeos on aparegueu vosaltres o el vostre gos en els canals del club · Base jurídica: **consentiment** (autorització d'ús d'imatge), revocable en qualsevol moment\n- Finalitat: Complir obligacions fiscals, comptables i sanitàries (identificació dels gossos, vacunes) · Base jurídica: obligació legal (art. 6.1.c)\n- Finalitat: Seguretat del servei i registre d'auditoria de les accions al vostre compte · Base jurídica: interès legítim (art. 6.1.f)\n\n## 4. Destinataris i encarregats\n\n- **AgilityHub** (plataforma, allotjament i suport tècnic) i els seus subencarregats: [DigitalOcean, LLC] (servidors, regió [REGIÓ]), [Amazon Web Services EMEA SARL] (fitxers i documents, regió UE — París), [Twilio Inc. / SendGrid] (correus electrònics i SMS), [Functional Software, Inc. — Sentry] (errors tècnics).\n- **Entitat bancària del club** (remeses de domiciliació SEPA) i, si el club ho activa, **Stripe Payments Europe, Ltd.** (pagaments amb targeta).\n- **Federacions o organismes** només si vosaltres ho demaneu (llicències).\n- **Autoritats públiques** quan una llei ho exigeixi.\n\nEls proveïdors situats fora de l'Espai Econòmic Europeu tracten dades sota **clàusules contractuals tipus** i mesures complementàries.\n\n## 5. Conservació\n\n- Dades d'abonat i gos: mentre sigueu abonats i, després de la baixa, el temps necessari per atendre responsabilitats (**[5] anys** per a les dades comptables i de pagament, segons la legislació fiscal i mercantil); la resta es **pseudonimitza** en aquest termini o abans si ho demaneu.\n- Sol·licituds d'alta no validades: **[1] any**.\n- Imatges: fins que retireu l'autorització; la retirada no afecta el que ja s'ha publicat abans, però el club deixarà d'usar-les.\n- Registres d'auditoria: **[6] anys**.\n\n## 6. Els vostres drets\n\nAccés, rectificació, supressió, oposició, limitació, portabilitat i retirada del consentiment: des de l'app (Perfil → Les meves dades; Perfil → Avisos; el paquet de dades el podeu demanar a Perfil → Les meves dades → «Descarrega les meves dades») o escrivint a [CORREU DEL CLUB]. Per a la supressió del compte, el club pseudonimitza les dades que no ha de conservar per llei. Podeu reclamar davant l'Agència Espanyola de Protecció de Dades (www.aepd.es) o l'Autoritat Catalana de Protecció de Dades (apdcat.gencat.cat).\n\n## 7. Menors\n\nEls menors de **14 anys** només poden ser abonats amb l'autorització del pare, mare o tutor legal, que facilita les dades i exerceix els drets en nom seu. [Adaptar si el club admet menors com a guies.]\n\n## 8. Dades bancàries\n\nL'IBAN es guarda xifrat i només el veu l'administració del club de manera emmascarada; les targetes es gestionen directament al proveïdor de pagaments i el club només guarda un identificador i els quatre últims dígits.\n\n## 9. Canvis\n\nEls canvis d'aquesta política es comuniquen a l'app; la versió acceptada i la data queden registrades a la vostra fitxa. Versió [1.0] · [DD-MM-AAAA].\n"},"active":false},{"key":"RULES","title":{"ca":"Normes del club","es":"Normas del club","en":"Club rules"},"body":{"es":"[Text pendent — el club l'omplirà des de Paràmetres]","en":"[Text pendent — el club l'omplirà des de Paràmetres]","ca":"[Text pendent — el club l'omplirà des de Paràmetres]\n\n# Normes del club\n\n## 1. Accés i horari\n- El camp obre de **[07:00 a 22:00]** tots els dies. Només hi poden entrar les persones abonades i els seus acompanyants; els acompanyants no poden entrar a les pistes durant les classes.\n- Cal presentar-se a la pista **5 minuts abans** de l'hora de la classe. Una classe comença a l'hora: qui arriba tard s'incorpora sense interrompre el grup.\n- L'aparcament és a [zona indicada]; deixeu lliure l'accés dels vehicles de servei.\n\n## 2. Els gossos\n- Tots els gossos han de tenir la **cartilla de vacunes al dia** (vacuna antiràbica i les obligatòries a Catalunya) i **microxip**; el club la demana a l'alta i la pot reclamar en qualsevol moment.\n- Els gossos van **lligats** fora de la pista i en tots els espais comuns; només se solten dins la pista durant la classe o l'entrenament.\n- Les femelles en zel no poden entrar a la pista. Un gos malalt o amb símptomes contagiosos es queda a casa.\n- Cada guia és responsable del seu gos: comportament, recollida dels excrements (**sempre**, amb les bosses de les papereres) i danys que pugui causar.\n- No es deixa mai un gos sol lligat o dins d'un vehicle al sol.\n\n## 3. Classes i reserves\n- Les classes es reserven des de l'app: fins a **[2] classes la setmana en curs i [1] la setmana següent** per gos; les inscripcions de la setmana següent s'obren el **[diumenge a les 20:00]**.\n- Una reserva es pot anul·lar fins a **[4 hores]** abans; després compta com a classe feta. Si no podeu venir, anul·leu: la plaça la pot aprofitar algú de la llista d'espera.\n- Una classe necessita un mínim de **[2] gossos**; el club avisa el dia abans si perilla i, si no arriba al mínim, l'anul·la el mateix matí a les [7:30].\n- El nivell de cada gos l'assigna l'equip d'instructors; les classes s'ordenen per nivells.\n\n## 4. Entrenament lliure\n- Hi tenen accés els gossos de nivell **[D]** o superior (o autoritzats expressament pel club) i cal reservar la pista des de l'app: **slots de [30] minuts, fins a [3] a la setmana**, amb **[3] dies** d'antelació com a màxim.\n- A cada pista només hi pot haver **un gos** durant l'entrenament lliure. Respecteu l'hora de sortida: darrere vostre hi ha una altra reserva.\n- Deixeu els obstacles com els heu trobat (o segons el recorregut muntat que indica l'app) i comuniqueu qualsevol desperfecte.\n\n## 5. Material i instal·lacions\n- El material d'agility és del club: no es treu de la pista, no es modifica l'alçada dels salts sense l'instructor i es guarda al seu lloc.\n- Aviseu de qualsevol obstacle trencat o insegur; no l'utilitzeu.\n- Papereres, aigua per als gossos i zones d'ombra: mantingueu-les netes per a tothom.\n\n## 6. Pagaments i baixes\n- Les quotes es cobren per **[domiciliació bancària]** el dia [1] de cada mes; els packs es paguen per avançat i caduquen ([Pack 6: 3 mesos · Pack 10: 5 mesos]).\n- Els períodes d'inactivitat i les baixes es demanen des de l'app abans del **dia [25]** del mes anterior.\n- Els rebuts retornats s'han de regularitzar abans de tornar a reservar.\n\n## 7. Convivència\n- Respecte a les persones, als gossos i als instructors; els mètodes d'entrenament del club es basen en el reforç positiu: no s'admeten correccions físiques ni material aversiu (collars de púes, elèctrics o d'ofec).\n- Els nens acompanyen sempre un adult i no entren a les pistes.\n- Les fotos i vídeos d'altres persones i gossos només es publiquen amb el seu permís.\n\n## 8. Incompliments\n- L'incompliment reiterat d'aquestes normes pot comportar el bloqueig temporal de les reserves i, en cas greu, la baixa del club, sempre després de parlar-ne amb la persona.\n\n*Darrera actualització: [DD-MM-AAAA] · [NOM DEL CLUB]*\n"},"active":true}]}
