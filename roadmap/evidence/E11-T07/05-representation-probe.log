package probe;

import java.math.BigDecimal;
import java.math.BigInteger;
import java.time.LocalDate;
import java.util.List;
import java.util.UUID;
import org.junit.jupiter.api.Test;
import org.springframework.data.annotation.Id;
import org.springframework.data.mongodb.core.convert.MappingMongoConverter;
import org.springframework.data.mongodb.core.convert.MongoCustomConversions;
import org.springframework.data.mongodb.core.convert.NoOpDbRefResolver;
import org.springframework.data.mongodb.core.mapping.Field;
import org.springframework.data.mongodb.core.mapping.FieldType;
import org.springframework.data.mongodb.core.mapping.MongoMappingContext;

class RepresentationProbeTest {
    record Money(long amountMinor, String currency) { }
    record Probe(@Id String id, @Field(targetType = FieldType.STRING) LocalDate validFrom, LocalDate plainDate, BigDecimal tax,
            BigInteger count, Money amount) { }

    @Test void probe() {
        var context = new MongoMappingContext();
        // What Spring Boot's MongoDataConfiguration builds when nothing is configured.
        var conversions = new MongoCustomConversions(List.of());
        context.setSimpleTypeHolder(conversions.getSimpleTypeHolder());
        context.afterPropertiesSet();
        var converter = new MappingMongoConverter(NoOpDbRefResolver.INSTANCE, context);
        converter.setCustomConversions(conversions);
        converter.afterPropertiesSet();
        var document = new org.bson.Document();
        converter.write(new Probe("p", LocalDate.parse("2026-01-01"), LocalDate.parse("2026-01-01"), new BigDecimal("21.00"),
                new BigInteger("12345678901234567890"), new Money(4500, "EUR")), document);
        System.out.println("PROBE " + org.springframework.core.SpringVersion.getVersion() + " canConvert(LocalDate,String)="
                + converter.getConversionService().canConvert(LocalDate.class, String.class));
        document.forEach((key, value) -> System.out.println("PROBE " + key + " = " + (value == null ? null : value.getClass().getName()) + " " + value));
    }
}
