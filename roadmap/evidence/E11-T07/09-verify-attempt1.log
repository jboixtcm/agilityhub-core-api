efault":0,"minimum":0}},{"name":"size","in":"query","description":"Requested page size: 20, 50, 200 or 1000 (CONVENCIONS_API §4); any other value is 400 INVALID_FILTER.","schema":{"type":"integer","format":"int32","default":50,"enum":[20,50,200,1000]}},{"name":"sort","in":"query","description":"Repeat field,asc or field,desc; only x-sortable fields.","style":"form","explode":true,"schema":{"type":"array","items":{"type":"string"}}},{"name":"q","in":"query","description":"Free-text search within the caller's permitted projection.","schema":{"type":"string"}},{"name":"filter","in":"query","description":"Repeat field:op:value; operators eq, ne, in, nin, lt, lte, gt, gte, contains, startsWith, exists, between. Only x-filterable fields; otherwise INVALID_FILTER.","style":"form","explode":true,"schema":{"type":"array","items":{"type":"string"}}},{"name":"fields","in":"query","description":"Comma-separated keys of this operation's x-fields; any other key is INVALID_FILTER. A list sends the row id and the requested keys only. An export takes the requested keys that are columns (x-columns) as its columns when columns is absent; none of them is INVALID_FILTER.","schema":{"type":"string"}}],"responses":{"200":{"description":"ListPage<RingBlockListItem>","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListPageRingBlockListItem"}}}},"400":{"description":"VALIDATION_ERROR","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"403":{"description":"IMPERSONATION_DENIED","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"NOT_FOUND","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"401":{"description":"Unauthorized","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"409":{"description":"Conflict","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"422":{"description":"Unprocess