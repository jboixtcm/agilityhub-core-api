      "/api/v1/me/history" : {
        "get" : {
          "description" : "Roles: MEMBER (also the impersonation token). Screen 25 (R-10-14): own and family-group dogs, history.monthsVisible months, startsAt desc, at most 500, no live bookings (they are on 03; cancelled ones appear, future ones too). dogId absent = «Tots»; a dog that is not accessible → 404 DOG_NOT_ACCESSIBLE. TRAINING items need FREE_TRAINING, ACTIVITY items ACTIVITIES (listed with «Tots» only). Tenant comes from the JWT.",
          "operationId" : "memberHistory",
          "parameters" : [ {
            "in" : "query",
            "name" : "dogId",
            "required" : false,
            "schema" : {
              "type" : "string"
            }
          }, {
            "in" : "query",
            "name" : "type",
            "required" : false,
            "schema" : {
              "enum" : [ "CLASS", "TRAINING", "ACTIVITY" ],
              "type" : "string"
            }
          } ],
          "responses" : {
