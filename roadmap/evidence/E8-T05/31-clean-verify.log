          "security" : [ ],
          "summary" : "Issue tokens using an OAuth2 or AgilityHub grant",
          "tags" : [ "identity" ],
          "x-grants" : {
            "authorization_code" : {
              "optional" : [ "client_secret", "code_verifier", "scope" ],
              "required" : [ "client_id", "code", "redirect_uri" ]
            },
            "password" : {
              "optional" : [ "client_secret", "scope" ],
              "required" : [ "client_id", "username", "password" ]
            },
            "refresh_token" : {
              "cookie" : "ah_refresh for COOKIE clients; refresh_token required for BODY clients",
              "optional" : [ "refresh_token", "client_secret", "scope" ],
              "required" : [ "client_id" ]
