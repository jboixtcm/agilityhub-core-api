# Spring profile: local (default, no Mongo), test, staging or prod.
SPRING_PROFILES_ACTIVE=local
# HTTP port; defaults to 8080.
SERVER_PORT=8080
# MongoDB 7 host; required in staging/prod.
MONGODB_HOST=localhost
# MongoDB port; defaults to 27017.
MONGODB_PORT=27017
# MongoDB application database; required in staging/prod.
MONGODB_DATABASE=agilityhub
# MongoDB replica-set name; defaults to rs0.
MONGODB_REPLICA_SET=rs0
# MongoDB authentication database; defaults to admin.
MONGODB_AUTH_DATABASE=admin
# MongoDB login supplied by the deployment environment; required in staging/prod.
MONGODB_USERNAME=
# MongoDB password supplied by the deployment environment; required in staging/prod.
MONGODB_PASSWORD=
# MongoDB 7 replica-set URI for integration tests; Testcontainers will override this in E0-T02.
MONGODB_TEST_URI=mongodb://localhost:27017/agilityhub_test?replicaSet=rs0
