# Spring profile for host execution: local (default), test, staging or prod.
# Compose always uses local with an unauthenticated development replica set.
SPRING_PROFILES_ACTIVE=local
# HTTP port on the host and inside the API container; defaults to 8080.
SERVER_PORT=8080
# MongoDB 7 host for host execution; Compose overrides it with mongo.
# Required in staging/prod.
MONGODB_HOST=localhost
# MongoDB host port; defaults to 27017. Compose uses 27017 internally.
MONGODB_PORT=27017
# MongoDB application database; defaults to agilityhub locally; required in staging/prod.
MONGODB_DATABASE=agilityhub
# MongoDB replica-set name; defaults to rs0.
MONGODB_REPLICA_SET=rs0
# MongoDB authentication database; defaults to admin.
MONGODB_AUTH_DATABASE=admin
# MongoDB login supplied by the deployment environment; required in staging/prod.
MONGODB_USERNAME=
# MongoDB password supplied by the deployment environment; required in staging/prod.
MONGODB_PASSWORD=
# MongoDB 7 replica-set URI for manual test-profile execution.
# AbstractIntegrationTest always overrides this with its isolated Testcontainers URI.
MONGODB_TEST_URI=mongodb://localhost:27017/agilityhub_test?replicaSet=rs0&directConnection=true

# Stable JWT issuer; use the same value for issuing and validating tokens.
AUTH_ISSUER=https://id.agilitydoghub.com
# Current published platform privacy policy; version changes request renewed consent.
PLATFORM_PRIVACY_POLICY_VERSION=v1
PLATFORM_PRIVACY_POLICY_URL=https://id.agilitydoghub.com/privacy
# AES-256 master key (base64 of 32 random bytes); required in staging/prod.
# Generate outside version control. The same value must reach every API and CLI process.
# Blank local/test uses an ephemeral, non-persisted key ring; set it for durable local keys.
OIDC_MASTER_KEY=
# Required in staging/prod. Client secrets are bcrypt-hashed at configuration load.
OIDC_LEARN_CLIENT_SECRET=
# Login UI must share the AUTH_ISSUER HTTPS origin so its host-only cookie is available.
OIDC_LOGIN_URL=https://id.agilitydoghub.com/login
# Exact redirect allowlists; change these to the deployed product callbacks.
OIDC_CLUBS_APP_REDIRECT_URI=https://clubs.agilitydoghub.com/oidc/callback
OIDC_CLUBS_APP_LOGOUT_URI=https://clubs.agilitydoghub.com/
OIDC_CLUBS_ADMIN_REDIRECT_URI=https://clubsadmin.agilitydoghub.com/oidc/callback
OIDC_CLUBS_ADMIN_LOGOUT_URI=https://clubsadmin.agilitydoghub.com/
OIDC_ID_WEB_REDIRECT_URI=https://id.agilitydoghub.com/oidc/callback
OIDC_ID_WEB_LOGOUT_URI=https://id.agilitydoghub.com/
OIDC_AR_APP_REDIRECT_URI=https://ar.agilitydoghub.com/oidc/callback
OIDC_AR_APP_LOGOUT_URI=https://ar.agilitydoghub.com/
OIDC_LEARN_REDIRECT_URI=https://learn.agilitydoghub.com/oidc/callback
OIDC_LEARN_LOGOUT_URI=https://learn.agilitydoghub.com/
# Optional bin/oidc-smoke overrides; use fictional local accounts only.
OIDC_SMOKE_BASE_URL=http://127.0.0.1:8080
OIDC_SMOKE_EMAIL=admin@example.test
OIDC_SMOKE_PASSWORD=
# Required only when running identity:seed-test-accounts; no default password.
SEED_PASSWORD=

# Comma-separated exact platform hosts permitted by CORS (HTTPS in staging/prod).
CORS_PLATFORM_HOSTS=id.agilitydoghub.com,clubs.agilitydoghub.com,clubsadmin.agilitydoghub.com
# Java regex matching trusted Caddy proxy IPs for Tomcat X-Forwarded-For processing.
# Empty trusts no proxies; never use a wildcard matching untrusted clients.
TRUSTED_PROXY_PATTERN=

# Transactional email. Required in staging/prod; local without a key uses a metadata-only log sink.
SENDGRID_API_KEY=
# Verified platform sender email address (address only).
MAIL_FROM_PLATFORM=
# SendGrid Event Webhook ECDSA public key, base64 DER or PUBLIC KEY PEM.
SENDGRID_WEBHOOK_PUBLIC_KEY=
