# Copy to .env.consumer. Supply a local password (at least 12 characters).
# Never commit the filled file. All seeded identities are fictional @example.test.
SEED_PASSWORD=
CORE_IMAGE=ghcr.io/jboixtcm/agilityhub-core-api:main
CONSUMER_PORT=8080
# Optional isolation overrides; keep these stable while reusing volumes.
CONSUMER_DATABASE=agilityhub
COMPOSE_PROJECT_NAME=agilityhub-consumer
