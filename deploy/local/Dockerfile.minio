# Local test dependency only. Upstream no longer distributes the former images.
FROM golang:1.24.8-bookworm AS build
ADD --checksum=sha256:be6d0bd3696c3a13a35f02d3a0280b64319c67918b4501c5c3d87f96d000085c https://codeload.github.com/minio/minio/tar.gz/refs/tags/RELEASE.2025-10-15T17-29-55Z /tmp/minio.tar.gz
RUN mkdir /source && tar -xzf /tmp/minio.tar.gz -C /source --strip-components=1
WORKDIR /source
RUN CGO_ENABLED=0 go build -buildvcs=false -o /out/minio .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/minio /usr/local/bin/minio
ENTRYPOINT ["minio"]
