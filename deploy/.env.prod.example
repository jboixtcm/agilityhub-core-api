# Copy OUTSIDE version control to a mode-0600 deployment environment file.
# Placeholders are deliberately unusable; never source untrusted env files.
# Keep an encrypted off-host escrow copy of every key and old backup identity.
MONGO_ROOT_USERNAME=coreRoot
MONGO_ROOT_PASSWORD=REPLACE_BEFORE_RELEASE
MONGO_REPLICA_KEY=REPLACE_BEFORE_RELEASE
MONGODB_DATABASE=agilityhub
MONGODB_USERNAME=coreApp
MONGODB_PASSWORD=REPLACE_BEFORE_RELEASE
MONGO_BACKUP_USERNAME=coreBackup
MONGO_BACKUP_PASSWORD=REPLACE_BEFORE_RELEASE
IMAGE_TAG=sha-REPLACE
TRUSTED_PROXY_PATTERN='172\.30\.240\.10'
AUTH_ISSUER=https://id.agilitydoghub.com
PLATFORM_PRIVACY_POLICY_VERSION=v1
PLATFORM_PRIVACY_POLICY_URL=https://id.agilitydoghub.com/privacy
OIDC_MASTER_KEY=REPLACE_BEFORE_RELEASE
OIDC_LEARN_CLIENT_SECRET=REPLACE_BEFORE_RELEASE
OIDC_LOGIN_URL=https://id.agilitydoghub.com/login
OIDC_ID_WEB_REDIRECT_URI=https://id.agilitydoghub.com/oidc/callback
OIDC_ID_WEB_LOGOUT_URI=https://id.agilitydoghub.com/
OIDC_CLUBS_APP_REDIRECT_URI=https://clubs.agilitydoghub.com/oidc/callback
OIDC_CLUBS_APP_LOGOUT_URI=https://clubs.agilitydoghub.com/
OIDC_CLUBS_ADMIN_REDIRECT_URI=https://clubsadmin.agilitydoghub.com/oidc/callback
OIDC_CLUBS_ADMIN_LOGOUT_URI=https://clubsadmin.agilitydoghub.com/
OIDC_AR_APP_REDIRECT_URI=https://ar.agilitydoghub.com/oidc/callback
OIDC_AR_APP_LOGOUT_URI=https://ar.agilitydoghub.com/
OIDC_LEARN_REDIRECT_URI=https://learn.agilitydoghub.com/oidc/callback
OIDC_LEARN_LOGOUT_URI=https://learn.agilitydoghub.com/
CORS_PLATFORM_HOSTS=id.agilitydoghub.com,clubs.agilitydoghub.com,clubsadmin.agilitydoghub.com
SENDGRID_API_KEY=REPLACE_BEFORE_RELEASE
MAIL_FROM_PLATFORM=noreply@example.test
SENDGRID_WEBHOOK_PUBLIC_KEY=REPLACE_BEFORE_RELEASE
EMAIL_UNSUBSCRIBE_KEY=REPLACE_BEFORE_RELEASE
TWILIO_ACCOUNT_SID=REPLACE_BEFORE_RELEASE
TWILIO_AUTH_TOKEN=REPLACE_BEFORE_RELEASE
TWILIO_MESSAGING_SERVICE_SID=
SMS_ALLOWED_NUMBERS=
VAPID_PUBLIC_KEY=REPLACE_BEFORE_RELEASE
VAPID_PRIVATE_KEY=REPLACE_BEFORE_RELEASE
VAPID_SUBJECT=REPLACE_BEFORE_RELEASE
SIGNUP_CAPABILITY_KEY=REPLACE_BEFORE_RELEASE
BOOKING_CALENDAR_KEY=REPLACE_BEFORE_RELEASE
MIGRATION_BANK_KEY=
BILLING_BANK_KEY=REPLACE_BEFORE_RELEASE
EXPORT_S3_BUCKET=REPLACE_BEFORE_RELEASE
EXPORT_S3_REGION=eu-west-3
EXPORT_S3_ENDPOINT=
EXPORT_S3_ACCESS_KEY=REPLACE_BEFORE_RELEASE
EXPORT_S3_SECRET_KEY=REPLACE_BEFORE_RELEASE
ATTACHMENT_S3_BUCKET=REPLACE_BEFORE_RELEASE
ATTACHMENT_S3_REGION=eu-west-3
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_ACCESS_KEY=REPLACE_BEFORE_RELEASE
ATTACHMENT_S3_SECRET_KEY=REPLACE_BEFORE_RELEASE
SHARED_SCHEDULING_ENABLED=true
CORE_CONCURRENCY_LOCALLANES=true
ACME_EMAIL=operator@example.test
ID_HOST=id.agilitydoghub.com
CLUBS_HOST=clubs.agilitydoghub.com
ADMIN_HOST=clubsadmin.agilitydoghub.com
CORE_HOST=core.agilitydoghub.com
CLUB_ADMIN_HOSTS=unused.invalid
ID_DIST_DIR=/srv/agilityhub/web/id/dist
CLUBS_DIST_DIR=/srv/agilityhub/web/clubs/dist
ADMIN_DIST_DIR=/srv/agilityhub/web/clubsadmin/dist
CADDY_IPV4_ADDRESS=172.30.240.10
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=mongo/
BACKUP_S3_REGION=eu-west-3
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
DEPLOY_SUBNET=172.30.240.0/24

# Local override only (the smoke generates these; never deploy this profile):
LOCAL_MONGODB_URI=
LOCAL_HTTP_PORT=8088
LOCAL_HTTPS_PORT=8443
SEED_PASSWORD=

# E11-T03: optional Sentry error telemetry; empty disables it. No personal data or request bodies.
SENTRY_DSN=
# Finite MongoDB driver timeouts and connection pool bounds (infrastructure, not club parameters).
MONGO_CONNECT_TIMEOUT=2s
MONGO_SOCKET_TIMEOUT=5s
MONGO_SERVER_SELECTION_TIMEOUT=2s
MONGO_OPERATION_TIMEOUT=10s
MONGO_MAX_POOL_SIZE=100
MONGO_POOL_WAIT_TIMEOUT=2s
