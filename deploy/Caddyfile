{
    email {$ACME_EMAIL}
    acme_ca https://acme-v02.api.letsencrypt.org/directory
    {$CADDY_LOCAL_OPTIONS}
    on_demand_tls {
        # Caddy sends ?domain=; S17 specifies ?host=. Translate privately.
        ask http://127.0.0.1:9080/ask
    }
}

# E11-T03: baseline for static SPAs as well as API responses. The SPAs' Content-Security-Policy is set on their static answers
# only (CFG-04, `static_files`); API answers keep the Core's own policy.
(security_headers) {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

# CFG-07 (owner decision of 13 Nov 2026): every site logs its requests (address, method, host, path, status, size, duration,
# browser) as JSON to one rolled file in the `caddy-logs` volume, never to the container log. The query string is dropped from
# every URL logged, the request's own and those of its Referer and of a Location answer: OAuth and handoff codes, signatures,
# signed file URLs and the build-session stream's `?access_token=` (E9-T06) travel there. Caddy already redacts Authorization,
# Cookie and Set-Cookie. Rotation: a new file every 50 MiB, rolled files compressed, at most 30 kept and none older than 30 days
# (the addresses are personal data). The internal ask listener below is not a public site and is not logged.
(access_log) {
    log {
        output file /var/log/caddy/access.log {
            roll_size 50MiB
            roll_keep 30
            roll_keep_for 30d
        }
        format filter {
            wrap json
            fields {
                request>uri regexp \?.*$ ""
                request>headers>Referer regexp \?.*$ ""
                resp_headers>Location regexp \?.*$ ""
            }
        }
    }
}

# The deployment flag is independent of Core and all SPA assets.
(planned_maintenance) {
    @maintenance file {
        root /maintenance
        try_files enabled
    }
    handle @maintenance {
        error "planned maintenance" 503
    }
}

# F08: gateway failures remain unavailable, with a readable page for navigation and JSON for API clients.
# Do not expose the internal upstream, the request URI or signed query parameters in the response.
(gateway_unavailable) {
    import planned_maintenance
    handle_errors 502 503 504 {
        header {
            Cache-Control "no-store"
            Retry-After "30"
            X-Content-Type-Options "nosniff"
        }
        @navigation {
            method GET HEAD
            header Accept *text/html*
            not path /api/* /oauth2/* /.well-known/* /connect/logout
        }
        @planned_navigation {
            expression `{err.message} == "planned maintenance"`
            method GET HEAD
            header Accept *text/html*
            not path /api/* /oauth2/* /.well-known/* /connect/logout
        }
        handle @planned_navigation {
            header Content-Type "text/html; charset=utf-8"
            respond <<HTML
                <!doctype html>
                <html lang="ca"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
                <title>Actualització en curs</title>
                <style>:root{color-scheme:light dark}body{font:1.05rem/1.6 system-ui,sans-serif;max-width:40rem;margin:12vh auto;padding:1.5rem}h1{line-height:1.2}a{color:inherit;display:inline-block;padding:.7rem 1.2rem;border:1px solid;border-radius:.4rem}</style>
                <main><h1>Actualització en curs</h1><p>El servei no està disponible mentre acabem l’actualització. Torna-ho a provar d’aquí a uns instants.</p><p><a href="">Torna-ho a provar</a></p>
                <p lang="es">Actualización en curso. El servicio estará disponible en unos instantes.</p>
                <p lang="en">Update in progress. The service will be available again shortly.</p></main></html>
                HTML 503
        }
        handle @navigation {
            header Content-Type "text/html; charset=utf-8"
            respond <<HTML
                <!doctype html>
                <html lang="ca"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
                <title>Servei temporalment no disponible</title>
                <style>:root{color-scheme:light dark}body{font:1.05rem/1.6 system-ui,sans-serif;max-width:42rem;margin:10vh auto;padding:1.5rem}h1{line-height:1.2}a{color:inherit;display:inline-block;padding:.7rem 1.2rem;border:1px solid;border-radius:.4rem}small{display:block;margin-top:2rem}</style>
                <main><h1>Servei temporalment no disponible</h1><p>Espera uns instants i torna-ho a provar. Si estaves confirmant una reserva, comprova primer si apareix a Inici abans de repetir-la.</p><p><a href="">Torna-ho a provar</a></p>
                <p lang="es">Servicio temporalmente no disponible. Inténtalo de nuevo en unos instantes. Si estabas confirmando una reserva, comprueba antes si aparece en Inicio.</p>
                <p lang="en">Service temporarily unavailable. Please try again shortly. If you were confirming a booking, first check whether it appears on Home.</p><small>Referència / Referencia / Reference: {err.id}</small></main></html>
                HTML 503
        }
        handle {
            header Content-Type "application/json; charset=utf-8"
            respond `{"code":"INTERNAL_ERROR","message":"Service temporarily unavailable. Please try again shortly.","details":{},"traceId":"{err.id}"}` 503
        }
    }
}

(api_proxy) {
    @backend path /api/* /oauth2/* /.well-known/* /connect/logout
    handle @backend {
        reverse_proxy core:8080
    }
}

# CFG-03 (owner decision of 13 Nov 2026): a request body to /api/* or /oauth2/* stops at 2 MB (2,000,000 bytes) at the proxy, on
# every site that proxies them. Only the two signed upload PUTs legitimately take more: their bodies are files, bounded by the
# club's files.maxSizeMb as the Core streams them. Every other body is JSON or a form far below the cap (the Core reads at most
# 1 MiB of a keyed request, 64 KB of a public signup and 256 KB of a course model). A refused body, here or on the Core host's
# 1 MiB webhook cap, gets the API's own answer to an oversized body: 400 VALIDATION_ERROR in the standard error envelope.
(api_body_limit) {
    @api_body {
        path /api/* /oauth2/*
        not {
            method PUT
            path /api/v1/attachments/uploads/* /api/v1/signup/uploads
        }
    }
    request_body @api_body {
        max_size 2MB
    }
    handle_errors 413 {
        header {
            Cache-Control "no-store"
            X-Content-Type-Options "nosniff"
            Content-Type "application/json; charset=utf-8"
        }
        respond `{"code":"VALIDATION_ERROR","message":"The request body is too large.","details":{},"traceId":"{err.id}"}` 400
    }
}

# CFG-05: the static answers of an SPA (never the proxied API, which keeps its own headers). They are compressed and
# revalidated on every load, the entry document at `/` included, except an existing file under /assets/ (Vite names them by
# content hash), cached for a year. A dot path (`/.env`, `/.git/…`) is a 404, and so is a missing file with one of the listed
# extensions (`/sitemap.xml`, `/old.js`): only a path that looks like a route falls back to index.html with 200. An existing
# file is served: the bundle's own `robots.txt` (CFG-05), `content-security-policy.txt` (CFG-04) and `version.json` (REL-02).
# CFG-04 (owner decision of 13 Nov 2026): every static answer carries the Content-Security-Policy of the bundle it comes from:
# the one line its build wrote to `content-security-policy.txt` in the served root, with the sha256 of each inline script of that
# build's index.html, so the policy and the boot script cannot drift (the web checks the file at build time, release preflight
# again before a deploy). The file is read per request, so a new bundle brings its policy without a reload.
(static_files) {
    encode zstd gzip
    header Cache-Control "no-cache"
    @policy_id vars {http.vars.root} /srv/id
    header @policy_id Content-Security-Policy "{file./srv/id/content-security-policy.txt}"
    @policy_clubs vars {http.vars.root} /srv/clubs
    header @policy_clubs Content-Security-Policy "{file./srv/clubs/content-security-policy.txt}"
    @policy_clubsadmin vars {http.vars.root} /srv/clubsadmin
    header @policy_clubsadmin Content-Security-Policy "{file./srv/clubsadmin/content-security-policy.txt}"
    @dot_path path */.*
    respond @dot_path 404
    @asset path /assets/* /pwa/*
    handle @asset {
        @hashed {
            path /assets/*
            file
        }
        header @hashed Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    @not_a_route path *.js *.mjs *.css *.map *.json *.txt *.xml *.html *.ico *.png *.svg *.webmanifest *.fbx *.env *.php
    handle @not_a_route {
        file_server
    }
    try_files {path} /index.html
    file_server
}

(spa) {
    import access_log
    import gateway_unavailable
    import security_headers
    import api_body_limit
    import api_proxy
    handle {
        root * {args[0]}
        route {
            import static_files
        }
    }
}

{$ID_HOST} {
    import spa /srv/id
}
{$CLUBS_HOST} {
    import spa /srv/clubs
}
{$ADMIN_HOST} {
    import spa /srv/clubsadmin
}
{$CORE_HOST} {
    import access_log
    import gateway_unavailable
    @private path /internal/* /actuator/*
    respond @private 404
    # CFG-05 (owner decision of 13 Nov 2026): every host answers robots.txt with `Disallow: /`. The SPA hosts and club aliases
    # serve the one their bundle carries (each build writes it; release preflight refuses a bundle without it); the Core's own
    # host serves no bundle and answers the same two lines here.
    @robots path /robots.txt
    header @robots Content-Type "text/plain; charset=utf-8"
    respond @robots <<TXT
        User-agent: *
        Disallow: /

        TXT 200
    import api_body_limit
    # CFG-03: the anonymous webhooks (Stripe, Brevo, SendGrid) never send more than the 1 MiB the Core reads of them.
    request_body /webhooks/* {
        max_size 1MiB
    }
    reverse_proxy core:8080
}

# Never published by Compose. The API answers 200 only for a VERIFIED club domain (S17 R-17-03, E10-T04).
http://127.0.0.1:9080 {
    @ask path /ask
    handle @ask {
        rewrite * /internal/domains/allowed?host={query.domain}
        reverse_proxy {$CADDY_ASK_UPSTREAM}
    }
    respond 404
}

# INC-64 (E11-T09): which SPA a verified club host serves comes from the Core, per request: `forward_auth` asks
# `GET /internal/domains/app?host=` (always 200, `X-Club-App: clubs | clubs-admin`, the domain's own app) and the answer picks
# the root. A domain verified in the console serves its app at once: no host list, no reload. A client's own `X-Club-App` is
# dropped first. The Core answers only the internal network: the request leaves without forwarding headers (the peer is
# Caddy itself), without the client's credentials, URI or method (E11-T16) and with the upstream's own Host.
(club_spa) {
    route {
        request_header -X-Club-App
        forward_auth {$CADDY_APP_UPSTREAM} {
            # Caddy query-escapes a placeholder in this query: a Host with `&` or `=` stays one `host` value (E11-T09 round 2).
            uri /internal/domains/app?host={host}
            header_up Host {upstream_hostport}
            header_up -X-Forwarded-For
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
            header_up -Authorization
            header_up -Cookie
            # E11-T16: forward_auth's own copies of the client's request (its URI, whose query can carry a code, and its method).
            header_up -X-Forwarded-Uri
            header_up -X-Forwarded-Method
            copy_headers X-Club-App
            # forward_auth normally copies a non-2xx response without entering handle_errors.
            @routing_unavailable status 502 503 504
            handle_response @routing_unavailable {
                error 503
            }
        }
        # The two roots are one exclusive group: the first that matches wins, so the back office comes first.
        @club_admin header X-Club-App clubs-admin
        root @club_admin /srv/clubsadmin
        root * /srv/clubs
        import static_files
    }
}

https:// {
    import access_log
    import gateway_unavailable
    import security_headers
    tls {
        on_demand
    }
    import api_body_limit
    import api_proxy
    handle {
        import club_spa
    }
}
