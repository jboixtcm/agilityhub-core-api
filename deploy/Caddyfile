{
    email {$ACME_EMAIL}
    acme_ca https://acme-v02.api.letsencrypt.org/directory
    {$CADDY_LOCAL_OPTIONS}
    on_demand_tls {
        # Caddy sends ?domain=; S17 specifies ?host=. Translate privately.
        ask http://127.0.0.1:9080/ask
    }
}

# E11-T03: baseline for static SPAs as well as API responses. CSP for SPA scripts belongs to the web build.
(security_headers) {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

# E9-T06 (S16 R-16-11): the build session stream takes the access token as `?access_token=` (a browser EventSource sends no
# header). Access logging stays off (docs/DEPLOY.md: query strings carry signed capabilities); a site that turns it on imports
# this snippet, never a bare `log`, so the token is dropped from the logged URI. Caddy already redacts Authorization and Cookie.
(access_log) {
    log {
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete access_token
                }
            }
        }
    }
}

# F08: gateway failures remain unavailable, with a readable page for navigation and JSON for API clients.
# Do not expose the internal upstream, the request URI or signed query parameters in the response.
(gateway_unavailable) {
    handle_errors 502 503 504 {
        header {
            Cache-Control "no-store"
            Retry-After "30"
            X-Content-Type-Options "nosniff"
        }
        @navigation {
            method GET HEAD
            header Accept *text/html*
            not path /api/* /oauth2/* /.well-known/* /connect/logout
        }
        handle @navigation {
            header Content-Type "text/html; charset=utf-8"
            respond <<HTML
                <!doctype html>
                <html lang="ca"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
                <title>Servei temporalment no disponible</title>
                <style>:root{color-scheme:light dark}body{font:1.05rem/1.6 system-ui,sans-serif;max-width:42rem;margin:10vh auto;padding:1.5rem}h1{line-height:1.2}a{color:inherit;display:inline-block;padding:.7rem 1.2rem;border:1px solid;border-radius:.4rem}small{display:block;margin-top:2rem}</style>
                <main><h1>Servei temporalment no disponible</h1><p>Espera uns instants i torna-ho a provar. Si estaves confirmant una reserva, comprova primer si apareix a Inici abans de repetir-la.</p><p><a href="">Torna-ho a provar</a></p>
                <p lang="es">Servicio temporalmente no disponible. Inténtalo de nuevo en unos instantes. Si estabas confirmando una reserva, comprueba antes si aparece en Inicio.</p>
                <p lang="en">Service temporarily unavailable. Please try again shortly. If you were confirming a booking, first check whether it appears on Home.</p><small>Referència / Referencia / Reference: {err.id}</small></main></html>
                HTML 503
        }
        handle {
            header Content-Type "application/json; charset=utf-8"
            respond `{"code":"INTERNAL_ERROR","message":"Service temporarily unavailable. Please try again shortly.","details":{},"traceId":"{err.id}"}` 503
        }
    }
}

(api_proxy) {
    @backend path /api/* /oauth2/* /.well-known/* /connect/logout
    handle @backend {
        reverse_proxy core:8080
    }
}

(spa) {
    import gateway_unavailable
    import security_headers
    import api_proxy
    handle {
        root * {args[0]}
        route {
            try_files {path} /index.html
            header /index.html Cache-Control "no-cache"
            file_server
        }
    }
}

{$ID_HOST} {
    import spa /srv/id
}
{$CLUBS_HOST} {
    import spa /srv/clubs
}
{$ADMIN_HOST} {
    import spa /srv/clubsadmin
}
{$CORE_HOST} {
    import gateway_unavailable
    @private path /internal/* /actuator/*
    respond @private 404
    reverse_proxy core:8080
}

# Never published by Compose. The API answers 200 only for a VERIFIED club domain (S17 R-17-03, E10-T04).
http://127.0.0.1:9080 {
    @ask path /ask
    handle @ask {
        rewrite * /internal/domains/allowed?host={query.domain}
        reverse_proxy {$CADDY_ASK_UPSTREAM}
    }
    respond 404
}

# INC-64 (E11-T09): which SPA a verified club host serves comes from the Core, per request: `forward_auth` asks
# `GET /internal/domains/app?host=` (always 200, `X-Club-App: clubs | clubs-admin`, the domain's own app) and the answer picks
# the root. A domain verified in the console serves its app at once: no host list, no reload. A client's own `X-Club-App` is
# dropped first. The Core answers only the internal network: the request leaves without forwarding headers (the peer is
# Caddy itself), without the client's credentials, URI or method (E11-T16) and with the upstream's own Host.
(club_spa) {
    route {
        request_header -X-Club-App
        forward_auth {$CADDY_APP_UPSTREAM} {
            # Caddy query-escapes a placeholder in this query: a Host with `&` or `=` stays one `host` value (E11-T09 round 2).
            uri /internal/domains/app?host={host}
            header_up Host {upstream_hostport}
            header_up -X-Forwarded-For
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
            header_up -Authorization
            header_up -Cookie
            # E11-T16: forward_auth's own copies of the client's request (its URI, whose query can carry a code, and its method).
            header_up -X-Forwarded-Uri
            header_up -X-Forwarded-Method
            copy_headers X-Club-App
            # forward_auth normally copies a non-2xx response without entering handle_errors.
            @routing_unavailable status 502 503 504
            handle_response @routing_unavailable {
                error 503
            }
        }
        # The two roots are one exclusive group: the first that matches wins, so the back office comes first.
        @club_admin header X-Club-App clubs-admin
        root @club_admin /srv/clubsadmin
        root * /srv/clubs
        try_files {path} /index.html
        header /index.html Cache-Control "no-cache"
        file_server
    }
}

https:// {
    import gateway_unavailable
    import security_headers
    tls {
        on_demand
    }
    import api_proxy
    handle {
        import club_spa
    }
}
