{
    email {$ACME_EMAIL}
    {$CADDY_LOCAL_OPTIONS}
    on_demand_tls {
        # Caddy sends ?domain=; S17 specifies ?host=. Translate privately.
        ask http://127.0.0.1:9080/ask
    }
}

# E11-T03: baseline for static SPAs as well as API responses. CSP for SPA scripts belongs to the web build.
(security_headers) {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

# E9-T06 (S16 R-16-11): the build session stream takes the access token as `?access_token=` (a browser EventSource sends no
# header). Access logging stays off (docs/DEPLOY.md: query strings carry signed capabilities); a site that turns it on imports
# this snippet, never a bare `log`, so the token is dropped from the logged URI. Caddy already redacts Authorization and Cookie.
(access_log) {
    log {
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete access_token
                }
            }
        }
    }
}

(api_proxy) {
    @backend path /api/* /oauth2/* /.well-known/* /connect/logout
    handle @backend {
        reverse_proxy core:8080
    }
}

(spa) {
    import security_headers
    import api_proxy
    handle {
        root * {args[0]}
        route {
            try_files {path} /index.html
            header /index.html Cache-Control "no-cache"
            file_server
        }
    }
}

{$ID_HOST} {
    import spa /srv/id
}
{$CLUBS_HOST} {
    import spa /srv/clubs
}
{$ADMIN_HOST} {
    import spa /srv/clubsadmin
}
{$CORE_HOST} {
    @private path /internal/* /actuator/*
    respond @private 404
    reverse_proxy core:8080
}

# Never published by Compose; the API endpoint is pending E10-T02.
http://127.0.0.1:9080 {
    @ask path /ask
    handle @ask {
        rewrite * /internal/domains/allowed?host={query.domain}
        reverse_proxy {$CADDY_ASK_UPSTREAM}
    }
    respond 404
}

https:// {
    import security_headers
    tls {
        on_demand
    }
    import api_proxy
    @club_admin host {$CLUB_ADMIN_HOSTS}
    handle @club_admin {
        root * /srv/clubsadmin
        route {
            try_files {path} /index.html
            header /index.html Cache-Control "no-cache"
            file_server
        }
    }
    handle {
        root * /srv/clubs
        route {
            try_files {path} /index.html
            header /index.html Cache-Control "no-cache"
            file_server
        }
    }
}
