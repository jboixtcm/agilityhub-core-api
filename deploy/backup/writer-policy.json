{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow", "Action": ["s3:ListBucket"],
     "Resource": ["arn:aws:s3:::example-backups"],
     "Condition": {"StringLike": {"s3:prefix": ["mongo/*"]}}},
    {"Effect": "Allow", "Action": ["s3:PutObject"],
     "Resource": ["arn:aws:s3:::example-backups/mongo/*"]}
  ]
}
