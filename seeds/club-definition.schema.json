{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agilitydoghub.com/schemas/club-definition.schema.json",
  "title": "AgilityHub club definition v1",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "agilityhub.club/v1"
    },
    "club": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]{3,40}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "legalName": {
          "type": "string"
        },
        "taxId": {
          "type": "string"
        },
        "address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "country": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "contactEmail": {
          "type": "string"
        },
        "contactPhone": {
          "type": "string"
        },
        "websiteUrl": {
          "type": "string"
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ca",
              "es",
              "en"
            ]
          }
        },
        "defaultLocale": {
          "type": "string",
          "enum": [
            "ca",
            "es",
            "en"
          ]
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "countryProfile": {
          "type": "string",
          "enum": [
            "ES",
            "GENERIC"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ONBOARDING",
            "ACTIVE",
            "SUSPENDED"
          ]
        },
        "template": {
          "type": "boolean"
        }
      },
      "required": [
        "slug",
        "name",
        "locales",
        "defaultLocale",
        "timeZone",
        "currency",
        "countryProfile",
        "status"
      ],
      "additionalProperties": false
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.-]+$"
          },
          "primary": {
            "type": "boolean"
          },
          "app": {
            "type": "string",
            "enum": [
              "clubs",
              "clubs-admin"
            ]
          }
        },
        "required": [
          "host",
          "primary"
        ],
        "additionalProperties": false
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "logoUrl": {
          "type": "string"
        },
        "logoDarkUrl": {
          "type": "string"
        },
        "markUrl": {
          "type": "string"
        },
        "colors": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "onPrimary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "surfaceAlt": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "textMuted": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "success": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "warning": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "danger": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "info": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "primary",
            "background",
            "surface",
            "text"
          ],
          "additionalProperties": false
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1
        },
        "radius": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?px$"
        },
        "ringPalette": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "dark",
            "light",
            "auto"
          ]
        }
      },
      "required": [
        "colors",
        "fontFamily",
        "radius",
        "ringPalette",
        "mode"
      ],
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "FREE_TRAINING",
          "BILLING",
          "PACKS",
          "SINGLE_CLASS",
          "ACTIVITIES",
          "FAMILY_GROUP",
          "WAITLIST",
          "TASKS",
          "FAQ",
          "SMS",
          "PUSH",
          "INACTIVITY",
          "COURSES",
          "LEARN_LINK",
          "STATS",
          "SOCIAL_LEAGUE"
        ]
      }
    },
    "preset": {
      "type": "string",
      "enum": [
        "CANIC",
        "MINIM"
      ]
    },
    "paymentProviders": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "SEPA_XML",
          "STRIPE",
          "MANUAL"
        ]
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "admins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/admin"
      }
    },
    "catalogs": {
      "type": "object",
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogEntry"
          }
        },
        "rings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogEntry"
          }
        },
        "instructors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogEntry"
          }
        },
        "plans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogEntry"
          }
        },
        "prices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogEntry"
          }
        },
        "faq": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogEntry"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "messageTemplates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogEntry"
      }
    },
    "pwa": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string",
          "minLength": 1
        },
        "icons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string"
              },
              "sizes": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            },
            "required": [
              "src",
              "sizes",
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "shortName",
        "icons"
      ],
      "additionalProperties": false
    },
    "legal": {
      "type": "object",
      "properties": {
        "privacyPolicyUrl": {
          "type": "string"
        },
        "imageConsentText": {
          "type": "object",
          "minProperties": 0,
          "properties": {
            "ca": {
              "type": "string",
              "minLength": 1
            },
            "es": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "legalTextsVersion": {
          "type": "string"
        }
      },
      "required": [
        "privacyPolicyUrl",
        "imageConsentText",
        "legalTextsVersion"
      ],
      "additionalProperties": false
    },
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/account"
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "required": [
    "apiVersion",
    "club",
    "theme"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "modules"
      ],
      "not": {
        "required": [
          "preset"
        ]
      }
    },
    {
      "required": [
        "preset"
      ],
      "not": {
        "required": [
          "modules"
        ]
      }
    }
  ],
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "ca": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "catalogEntry": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "ca": {
              "type": "string",
              "minLength": 1
            },
            "es": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "active": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "admin": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "enum": [
            "ca",
            "es",
            "en"
          ]
        }
      },
      "required": [
        "email",
        "name",
        "locale"
      ],
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "locale": {
          "type": "string",
          "enum": [
            "ca",
            "es",
            "en"
          ]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ADMIN",
              "INSTRUCTOR",
              "MEMBER"
            ]
          }
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "description": "Use ${SEED_PASSWORD}; literal passwords are allowed only in local/test and must never be committed."
        },
        "onboardingPending": {
          "type": "boolean"
        }
      },
      "required": [
        "email",
        "name",
        "locale",
        "roles"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^(RULES|PRIVACY|IMAGE_CONSENT|WELCOME_GUIDE|[a-z0-9-]{2,40})$"
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "body": {
          "$ref": "#/$defs/localizedText"
        },
        "bodyFile": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "ca": {
              "type": "string",
              "minLength": 1
            },
            "es": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "title",
        "active"
      ],
      "anyOf": [
        {
          "required": [
            "body"
          ]
        },
        {
          "required": [
            "bodyFile"
          ]
        }
      ],
      "additionalProperties": false
    }
  }
}
