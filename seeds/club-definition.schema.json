{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agilitydoghub.com/schemas/club-definition.schema.json",
  "title": "AgilityHub club definition v1",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "agilityhub.club/v1"
    },
    "club": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]{3,40}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "legalName": {
          "type": "string"
        },
        "taxId": {
          "type": "string"
        },
        "address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "country": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "contactEmail": {
          "type": "string"
        },
        "contactPhone": {
          "type": "string"
        },
        "websiteUrl": {
          "type": "string"
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ca",
              "es",
              "en"
            ]
          }
        },
        "defaultLocale": {
          "type": "string",
          "enum": [
            "ca",
            "es",
            "en"
          ]
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "countryProfile": {
          "type": "string",
          "enum": [
            "ES",
            "GENERIC"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ONBOARDING",
            "ACTIVE",
            "SUSPENDED"
          ]
        },
        "template": {
          "type": "boolean"
        }
      },
      "required": [
        "slug",
        "name",
        "locales",
        "defaultLocale",
        "timeZone",
        "currency",
        "countryProfile",
        "status"
      ],
      "additionalProperties": false
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.-]+$"
          },
          "primary": {
            "type": "boolean"
          },
          "app": {
            "type": "string",
            "enum": [
              "clubs",
              "clubs-admin"
            ]
          }
        },
        "required": [
          "host",
          "primary"
        ],
        "additionalProperties": false
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "logoUrl": {
          "type": "string"
        },
        "logoDarkUrl": {
          "type": "string"
        },
        "markUrl": {
          "type": "string"
        },
        "colors": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "onPrimary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "surfaceAlt": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "textMuted": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "success": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "warning": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "danger": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "info": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "primary",
            "background",
            "surface",
            "text"
          ],
          "additionalProperties": false
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1
        },
        "radius": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?px$"
        },
        "ringPalette": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "dark",
            "light",
            "auto"
          ]
        }
      },
      "required": [
        "colors",
        "fontFamily",
        "radius",
        "ringPalette",
        "mode"
      ],
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "FREE_TRAINING",
          "BILLING",
          "PACKS",
          "SINGLE_CLASS",
          "ACTIVITIES",
          "FAMILY_GROUP",
          "WAITLIST",
          "TASKS",
          "FAQ",
          "SMS",
          "PUSH",
          "INACTIVITY",
          "COURSES",
          "LEARN_LINK",
          "STATS",
          "SOCIAL_LEAGUE"
        ]
      }
    },
    "preset": {
      "type": "string",
      "enum": [
        "CANIC",
        "MINIM"
      ]
    },
    "paymentProviders": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "SEPA_XML",
          "STRIPE",
          "MANUAL"
        ]
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "admins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/admin"
      }
    },
    "catalogs": {
      "type": "object",
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/level"
          }
        },
        "rings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ring"
          }
        },
        "instructors": {
          "type": "array",
          "maxItems": 0,
          "description": "Team members are provisioned by seed:demo after the census exists."
        },
        "plans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plan"
          }
        },
        "prices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/price"
          }
        },
        "faq": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/faq"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "messageTemplates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogEntry"
      }
    },
    "pwa": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string",
          "minLength": 1
        },
        "icons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string"
              },
              "sizes": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            },
            "required": [
              "src",
              "sizes",
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "shortName",
        "icons"
      ],
      "additionalProperties": false
    },
    "legal": {
      "type": "object",
      "properties": {
        "privacyPolicyUrl": {
          "type": "string"
        },
        "imageConsentText": {
          "type": "object",
          "minProperties": 0,
          "properties": {
            "ca": {
              "type": "string",
              "minLength": 1
            },
            "es": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "legalTextsVersion": {
          "type": "string"
        }
      },
      "required": [
        "privacyPolicyUrl",
        "imageConsentText",
        "legalTextsVersion"
      ],
      "additionalProperties": false
    },
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/account"
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "required": [
    "apiVersion",
    "club",
    "theme"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "modules"
      ],
      "not": {
        "required": [
          "preset"
        ]
      }
    },
    {
      "required": [
        "preset"
      ],
      "not": {
        "required": [
          "modules"
        ]
      }
    }
  ],
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "ca": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "admin": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "enum": [
            "ca",
            "es",
            "en"
          ]
        }
      },
      "required": [
        "email",
        "name",
        "locale"
      ],
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "locale": {
          "type": "string",
          "enum": [
            "ca",
            "es",
            "en"
          ]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ADMIN",
              "INSTRUCTOR",
              "MEMBER"
            ]
          }
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "description": "Use ${SEED_PASSWORD}; literal passwords are allowed only in local/test and must never be committed."
        },
        "onboardingPending": {
          "type": "boolean"
        }
      },
      "required": [
        "email",
        "name",
        "locale",
        "roles"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^(RULES|PRIVACY|IMAGE_CONSENT|WELCOME_GUIDE|[a-z0-9-]{2,40})$"
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "body": {
          "$ref": "#/$defs/localizedText"
        },
        "bodyFile": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "ca": {
              "type": "string",
              "minLength": 1
            },
            "es": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "title",
        "active"
      ],
      "anyOf": [
        {
          "required": [
            "body"
          ]
        },
        {
          "required": [
            "bodyFile"
          ]
        }
      ],
      "additionalProperties": false
    },
    "level": {
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "active": {
          "type": "boolean"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,16}$"
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "color": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "grantsFreeTraining": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "name",
        "color",
        "capacity",
        "grantsFreeTraining",
        "order",
        "active"
      ],
      "additionalProperties": false
    },
    "ring": {
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "active": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "shortName": {
          "type": "string",
          "pattern": "^[A-Z0-9]{1,6}$"
        },
        "color": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "allowsFreeTraining": {
          "type": "boolean"
        },
        "trainingCapacity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "name",
        "shortName",
        "color",
        "allowsFreeTraining",
        "order",
        "active"
      ],
      "additionalProperties": false
    },
    "money": {
      "type": "object",
      "properties": {
        "amountMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amountMinor",
        "currency"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "active": {
          "type": "boolean"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,16}$"
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "type": {
          "type": "string",
          "enum": [
            "MONTHLY",
            "PACK",
            "SINGLE_CLASS"
          ]
        },
        "billingMode": {
          "type": "string",
          "enum": [
            "MONTHLY_FEE",
            "MAINTENANCE"
          ]
        },
        "dogsIncluded": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "entryFee": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "STANDARD",
                "AMOUNT",
                "PERCENT",
                "NONE"
              ]
            },
            "amount": {
              "$ref": "#/$defs/money"
            },
            "percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "pack": {
          "type": "object",
          "properties": {
            "sessions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "validityMonths": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            }
          },
          "required": [
            "sessions",
            "validityMonths"
          ],
          "additionalProperties": false
        },
        "singleClass": {
          "type": "object",
          "properties": {
            "chargeMode": {
              "type": "string",
              "enum": [
                "CHARGE_ON_ATTENDANCE",
                "PAY_TO_BOOK"
              ]
            },
            "cancelPolicy": {
              "type": "string",
              "enum": [
                "REFUND",
                "CREDIT",
                "NONE"
              ]
            }
          },
          "required": [
            "chargeMode",
            "cancelPolicy"
          ],
          "additionalProperties": false
        },
        "conditions": {
          "$ref": "#/$defs/localizedText"
        },
        "texts": {
          "type": "object",
          "properties": {
            "description": {
              "$ref": "#/$defs/localizedText"
            },
            "offerLabel": {
              "$ref": "#/$defs/localizedText"
            },
            "priceLabel": {
              "$ref": "#/$defs/localizedText"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "showOnSignup": {
          "type": "boolean"
        },
        "showOnWeb": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "name",
        "type",
        "dogsIncluded",
        "entryFee",
        "order",
        "active",
        "showOnSignup",
        "showOnWeb"
      ],
      "additionalProperties": false
    },
    "price": {
      "type": "object",
      "properties": {
        "planCode": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,16}$"
        },
        "concept": {
          "type": "string",
          "enum": [
            "MONTHLY_FEE",
            "MAINTENANCE_FEE",
            "PACK",
            "SINGLE_CLASS"
          ]
        },
        "amount": {
          "$ref": "#/$defs/money"
        },
        "taxPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.01
        },
        "validFrom": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "validTo": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "planCode",
        "concept",
        "amount",
        "taxPercent",
        "validFrom"
      ],
      "additionalProperties": false
    },
    "faq": {
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "active": {
          "type": "boolean"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "$ref": "#/$defs/localizedText"
        },
        "question": {
          "$ref": "#/$defs/localizedText"
        },
        "answer": {
          "$ref": "#/$defs/localizedText"
        }
      },
      "required": [
        "code",
        "category",
        "question",
        "answer",
        "order",
        "active"
      ],
      "additionalProperties": false
    }
  }
}
