#!/usr/bin/env python3
"""Capture the initial contract from the running local development API."""

import json
from pathlib import Path
from urllib.request import urlopen

with urlopen("http://localhost:8080/v3/api-docs", timeout=30) as response:
    document = json.load(response)

destination = Path(__file__).resolve().parents[1] / "docs/openapi/openapi.json"
destination.parent.mkdir(parents=True, exist_ok=True)
destination.write_text(json.dumps(document, indent=2, sort_keys=True) + "\n", encoding="utf-8")
print("Updated docs/openapi/openapi.json")
