#!/usr/bin/env python3
"""Generate the contract with an isolated test server, then update the reviewed snapshot."""

import argparse
from pathlib import Path
import shutil
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--from-build", action="store_true", help="copy target/openapi.json after a successful mvnw verify")
args = parser.parse_args()
root = Path(__file__).resolve().parents[1]
source = root / "target/openapi.json"
if not args.from_build:
    source.unlink(missing_ok=True)
    subprocess.run([str(root / "mvnw"), "-q", "-Dtest=OpenApiSnapshotTest", "-Dopenapi.snapshot.update=true", "test"], cwd=root, check=True)
if not source.is_file():
    parser.error("target/openapi.json is missing; run bin/openapi-snapshot to generate it")

destination = root / "docs/openapi/openapi.json"
destination.parent.mkdir(parents=True, exist_ok=True)
shutil.copyfile(source, destination)
print("Updated docs/openapi/openapi.json")
