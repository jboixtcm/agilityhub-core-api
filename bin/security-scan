#!/usr/bin/env python3
"""E11-T03: pinned Trivy; fail on any image secret or a fixable CRITICAL vulnerability.

E8-T08 (E92): a fixable CRITICAL whose fix exists only outside the release line in use may be suppressed by an entry of
`bin/security-scan-suppressions.json` that names the exact package version, the reason, the task that recorded it and an
expiry at most 90 days after it was recorded. A malformed or over-long entry fails the audit; an expired one stops
applying, so the finding blocks again."""
import datetime
import hashlib
import json
import os
from pathlib import Path
import platform
import subprocess
import sys
import tarfile
import tempfile
import urllib.request

ROOT = Path(__file__).resolve().parent.parent
VERSION = '0.74.0'
PACKAGES = {
    ('Linux', 'x86_64'): ('Linux-64bit', '2ae6fe3ee734b7fdf11335663e18c75ea12dccc76062f09f164a3b0f8be4371a'),
    ('Darwin', 'arm64'): ('macOS-ARM64', '1caada5e0e2091909357c7525d3aa76f4b660b13821bc143b190c7483e31cc11'),
}


REQUIRED_JAVA_PACKAGES = {'org.springframework.security:spring-security-core', 'org.springframework:spring-web',
                          'org.mongodb:mongodb-driver-sync'}
SUPPRESSIONS = ROOT / 'bin' / 'security-scan-suppressions.json'
SUPPRESSION_FIELDS = ('id', 'package', 'installedVersion', 'recorded', 'expires', 'task', 'reason')
MAX_SUPPRESSION_DAYS = 90


def suppressions(document, today):
    """The entries that apply today; raises ValueError on a malformed entry or one longer than the policy allows."""
    active, expired = [], []
    for entry in document.get('suppressions', []):
        missing = [field for field in SUPPRESSION_FIELDS if not isinstance(entry.get(field), str) or not entry[field].strip()]
        if missing:
            raise ValueError('Suppression %s lacks %s' % (entry.get('id', '?'), ', '.join(missing)))
        recorded = datetime.date.fromisoformat(entry['recorded'])
        expires = datetime.date.fromisoformat(entry['expires'])
        if not recorded <= expires <= recorded + datetime.timedelta(days=MAX_SUPPRESSION_DAYS):
            raise ValueError('Suppression %s must expire within %d days of %s' % (entry['id'], MAX_SUPPRESSION_DAYS, entry['recorded']))
        (active if today <= expires else expired).append(entry)
    return active, [entry['id'] for entry in expired]


def java_inventory(report):
    packages = {package.get('Name') for result in report.get('Results', [])
                if result.get('Type') in ('jar', 'pom', 'gradle', 'sbt')
                for package in result.get('Packages', [])}
    missing = REQUIRED_JAVA_PACKAGES - packages
    if missing:
        raise ValueError('Java dependency inventory incomplete: ' + ', '.join(sorted(missing)))
    return len(packages)


def findings(report, active=()):
    critical = []
    suppressed = []
    secrets = []
    total = 0
    reported = []
    for result in report.get('Results', []):
        for vulnerability in result.get('Vulnerabilities', []):
            total += 1
            if vulnerability.get('Severity') == 'CRITICAL' and vulnerability.get('FixedVersion'):
                match = next((entry for entry in active if (entry['id'], entry['package'], entry['installedVersion'])
                              == (vulnerability['VulnerabilityID'], vulnerability.get('PkgName'), vulnerability.get('InstalledVersion'))), None)
                if match:
                    suppressed.append((vulnerability['VulnerabilityID'], vulnerability.get('PkgName'), vulnerability.get('InstalledVersion'),
                                       vulnerability.get('FixedVersion'), match['expires'], vulnerability.get('Title')))
                else:
                    critical.append((vulnerability['VulnerabilityID'], vulnerability.get('PkgName'), vulnerability.get('FixedVersion')))
            else:
                reported.append((vulnerability['VulnerabilityID'], vulnerability.get('PkgName'),
                                 vulnerability.get('Severity'), vulnerability.get('InstalledVersion'), vulnerability.get('FixedVersion')))
        # Deliberately do not return Match / code lines: they can contain the secret.
        secrets.extend(secret.get('RuleID', 'secret') for secret in result.get('Secrets', []))
    return {'vulnerabilities': total, 'fixableCritical': critical, 'suppressedCritical': suppressed, 'secretRules': secrets,
            'otherFindings': reported}


def main():
    if len(sys.argv) != 3 or sys.argv[1] not in ('fs', 'rootfs', 'image'):
        raise SystemExit('usage: bin/security-scan fs <project> | rootfs <packaged-directory> | image <image-reference>')
    package, digest = PACKAGES[(platform.system(), platform.machine())]
    cache = ROOT / '.local' / 'security-tools'
    cache.mkdir(parents=True, exist_ok=True)
    executable = cache / ('trivy-' + VERSION)
    if not executable.exists():
        with tempfile.TemporaryDirectory() as temporary:
            archive = Path(temporary) / 'trivy.tar.gz'
            urllib.request.urlretrieve(f'https://github.com/aquasecurity/trivy/releases/download/v{VERSION}/trivy_{VERSION}_{package}.tar.gz', archive)
            if hashlib.sha256(archive.read_bytes()).hexdigest() != digest:
                raise SystemExit('Trivy checksum mismatch')
            with tarfile.open(archive) as tar:
                with tar.extractfile('trivy') as source:
                    executable.write_bytes(source.read())
            executable.chmod(0o755)
    mode, target = sys.argv[1:]
    with tempfile.TemporaryDirectory() as temporary:
        report = Path(temporary) / 'report.json'
        command = [str(executable), mode, '--scanners', 'vuln,secret' if mode == 'image' else 'vuln',
                   '--no-progress', '--format', 'json', '--output', str(report), '--exit-code', '0', '--timeout', '15m', target]
        print(f'Trivy {VERSION}: {mode} vulnerability audit' + (' and image secret scan' if mode == 'image' else ''), flush=True)
        environment = dict(os.environ, TRIVY_CACHE_DIR=str(cache / 'db'))
        subprocess.run(command, check=True, env=environment)
        document = json.loads(report.read_text())
        active, expired = suppressions(json.loads(SUPPRESSIONS.read_text()), datetime.datetime.now(datetime.timezone.utc).date())
        summary = findings(document, active)
        summary['expiredSuppressions'] = expired
        summary['javaPackages'] = java_inventory(document)
        output = json.dumps(summary, indent=2) + '\n'
        print(output, end='')
        if os.environ.get('GITHUB_STEP_SUMMARY'):
            with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as stream:
                stream.write(f'### Trivy {mode}\n\n```json\n{output}```\n')
        if summary['fixableCritical'] or summary['secretRules']:
            raise SystemExit(1)


if __name__ == '__main__':
    main()
