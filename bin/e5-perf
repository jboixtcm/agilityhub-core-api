#!/usr/bin/env python3
"""E5 load and concurrency evidence (S08 T-08-41, S15 T-15-30; ruling E28) with k6 on a disposable local Compose stack.

Starts the stack like bin/e5-smoke but seeds only the fictional load-test club (seeds/club-perf.yaml + demo-perf.yaml,
twice: the second run must change nothing): 330 members with one dog each and, in the two weeks after the anchor week,
eleven empty 5-seat classes per week. It moves the test clock to just before the Sunday-20:00 opening that closes the
anchor week, mints one impersonation token per member (the demo members have no password; the booking code path is the
member's), waits for P1 week-opening to finish (the N-33 fan-out) and runs perf/e5-seat-holds.js three times. P1 runs
before the peak, not during it: T-15-30 «the same peak while P1 fans out» stays open for the release performance pass:
  peak       300 DISTINCT members (--vus) arrive evenly over the first 5 s (--arrival-seconds) on the 10 empty classes of
             the week that opens (W1): p95 < 500 ms on POST /seat-holds, < 800 ms on the flow, every answer expected,
             all 50 seats booked (gated);
  last_seat  50 other members hold the single free seat of a W0 class at the same instant (gated);
  burst      the same 300 members all at the same instant on 10 empty W0 classes: correctness gated, latency reported.
After each run it asserts in Mongo the seats filled and that no class holds more ACTIVE + PAYMENT_PENDING bookings than
its capacity, and prints a RESULT line with the distinct members, the seats filled and the histogram of the answers.
k6 runs from PATH when installed, otherwise from the grafana/k6 image (`--k6 docker`). Tokens stay in a private
temporary file; SEED_PASSWORD and tokens are never printed.
"""
import argparse
import datetime
import importlib.machinery
import importlib.util
import json
import re
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parents[1]
K6_IMAGE = "grafana/k6:0.54.0"
ANSWERS = ["list 200", "hold 201", "hold 409 CLASS_FULL", "hold 409 SEAT_TAKEN", "booking 201"]


def load_smoke():
    loader = importlib.machinery.SourceFileLoader("e5smoke", str(ROOT / "bin" / "e5-smoke"))
    spec = importlib.util.spec_from_loader("e5smoke", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


class Perf:
    def __init__(self, smoke_module, private, image, vus, k6, arrival=5):
        self.s = smoke_module.Smoke(private, image)
        self.m = smoke_module
        self.private = private
        self.vus = vus
        self.k6 = k6
        self.arrival = arrival

    def mongo(self, script):
        return self.s.mongo(script)

    def sign_in(self):
        """The load-test club's admin (access tokens follow the moved clock: Smoke.set_clock calls this after every move)."""
        self.s.admin = self.s.login("perf.admin@example.test", "clubs-admin")

    def classes(self, week):
        """The club's ACTIVE classes of week +`week` after the anchor, by start, with capacity and live bookings."""
        start = self.s.week_start + datetime.timedelta(weeks=week)
        return self.mongo('db.class_sessions.find({clubId:' + json.dumps(self.club) + ',state:"ACTIVE",date:{$gte:' + json.dumps(str(start))
                          + ',$lt:' + json.dumps(str(start + datetime.timedelta(weeks=1))) + '}}).sort({startsAt:1,_id:1}).toArray()'
                          '.map(c=>({id:c._id,date:c.date,start:c.startTime,capacity:c.capacity,'
                          'live:db.bookings.countDocuments({classSessionId:c._id,state:{$in:["ACTIVE","PAYMENT_PENDING"]}})}))')

    def members(self):
        """ACTIVE members with an account, not blocked, each with its ACTIVE dog, by member number."""
        return self.mongo('db.members.find({clubId:' + json.dumps(self.club) + ',status:"ACTIVE",accountId:{$ne:null},"bookingBlock.active":{$ne:true}})'
                          '.sort({memberNumber:1}).toArray().map(m=>({member:m._id,dogs:db.dogs.find({memberId:m._id,status:"ACTIVE"})'
                          '.sort({_id:1}).toArray().map(d=>d._id)})).filter(m=>m.dogs.length>0)')

    def impersonate(self, member):
        """An impersonation token, or None for a member the admin may not impersonate (staff: 403 IMPERSONATION_DENIED)."""
        try:
            response = self.s.call("POST", f"/api/v1/members/{member}/impersonation-token", 201, access=self.s.admin,
                                   body=dict(reason="E5 k6 load run (fictional load-test data)"), quiet=True)
        except AssertionError as denied:
            if "403 IMPERSONATION_DENIED" in str(denied):
                return None
            raise
        return response["token"]

    def overbooked(self):
        return self.mongo('db.class_sessions.find({clubId:' + json.dumps(self.club) + '}).toArray().filter(c=>db.bookings.countDocuments('
                          '{classSessionId:c._id,state:{$in:["ACTIVE","PAYMENT_PENDING"]}})>c.capacity).map(c=>c._id)')

    def booked(self, class_ids):
        """Live bookings per class (in the given order) and the distinct members holding them."""
        rows = self.mongo('db.bookings.find({classSessionId:{$in:' + json.dumps(class_ids) + '},state:{$in:["ACTIVE","PAYMENT_PENDING"]}})'
                          '.toArray().map(b=>({c:b.classSessionId,m:b.memberId}))')
        return [sum(1 for r in rows if r["c"] == c) for c in class_ids], len({r["m"] for r in rows})

    def run_k6(self, name, pool, extra):
        pool_file = self.private / f"pool-{name}.json"
        pool_file.write_text(json.dumps([dict(token=e["token"], dogId=e["dogId"], classIds=e["classIds"]) for e in pool]))
        summary = self.private / f"summary-{name}.json"
        env = dict(BASE_URL=self.s.base, CLUB_HOST=self.s.host, POOL_FILE=str(pool_file), SCENARIO=name, **extra)
        if self.k6 == "local":
            args = ["k6", "run", "--quiet", "--summary-export", str(summary)]
            for key, value in env.items():
                args += ["-e", f"{key}={value}"]
            args.append(str(ROOT / "perf" / "e5-seat-holds.js"))
        else:
            # The API publishes its port on the host's loopback only: join the stack's network and call the service directly.
            env.update(BASE_URL=f"http://{self.s.service}:{self.s.env['SERVER_PORT']}", POOL_FILE="/work/" + pool_file.name)
            args = ["docker", "run", "--rm", "--network", f"{self.s.project}_default", "-v", f"{self.private}:/work",
                    "-v", f"{ROOT / 'perf'}:/scripts:ro", K6_IMAGE, "run", "--quiet", "--summary-export", "/work/" + summary.name]
            for key, value in env.items():
                args += ["-e", f"{key}={value}"]
            args.append("/scripts/e5-seat-holds.js")
        result = subprocess.run(args, cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=900)
        # k6's own summary holds only metric names and numbers; tokens never reach argv (they are in the pool file).
        print(result.stdout, flush=True)
        metrics = json.loads(summary.read_text())["metrics"] if summary.exists() else {}
        return result.returncode, metrics, result.stdout

    @staticmethod
    def count(metrics, name):
        return int(metrics.get(name, {}).get("count", 0))

    def histogram(self, metrics, output):
        """Every answer with its count: the expected ones from the k6 counters, the unexpected ones from k6's warnings."""
        counts = {label: self.count(metrics, "answer_" + label.split(" ", 1)[0] + "_" + label.split(" ", 1)[1].replace(" ", "_")) for label in ANSWERS}
        for label in re.findall(r"UNEXPECTED ([a-z]+ [0-9]{3}(?: [A-Z_]+)?)", output):
            counts["UNEXPECTED " + label] = counts.get("UNEXPECTED " + label, 0) + 1
        return ", ".join(f"{label} × {n}" for label, n in counts.items() if n)

    def diagnostics(self, code):
        if code != 0:
            # Without payloads: the exception classes the API logged during the run.
            logs = self.s.compose("logs", "--no-color", self.s.service, timeout=120)
            print("API exception classes: " + ", ".join(sorted(set(re.findall(r"([A-Za-z0-9_.]+(?:Exception|Error|Timeout))\b", logs)))[:40]), flush=True)

    def run(self):
        s, require = self.s, self.m.require
        seeds = (("club:apply", "seeds/club-perf.yaml"), ("seed:demo", "--club=perf", "--seed=42", self.m.WEEK_START))
        s.start(seeds, label="load-test club")
        self.club, s.host = s.club_ids["perf"], s.hosts["perf"]
        s.sign_in = self.sign_in
        self.sign_in()
        # P2 would review the anchor week's days the clock crosses; nothing of it matters here.
        s.call("PUT", "/api/v1/jobs/risk-review/switch", access=s.admin, body=dict(enabled=False), quiet=True)
        notify = s.call("GET", "/api/v1/parameters/messaging.notifyWeekOpening", access=s.admin, quiet=True)
        require(notify["value"] is True, "The load-test club must have the N-33 fan-out on (seeds/club-perf.yaml)")
        opening = s.local("SUNDAY", "20:00")  # closes the anchor week: week +2 becomes W1, week +1 is W0 (R-08-01)
        s.set_clock(opening - datetime.timedelta(minutes=30), "30 min before the opening (token minting)")

        w0, w1 = self.classes(1), self.classes(2)
        for week in (w0, w1):
            require(len(week) == 11 and all(c["capacity"] == 5 and c["live"] == 0 for c in week), "Need 11 empty 5-seat classes per week")
        peak_targets, burst_targets, last = w1[:10], w0[:10], w0[10]
        members = self.members()
        started = time.monotonic()
        pool = []
        for m in members:
            token = self.impersonate(m["member"])
            if token:
                pool.append(dict(member=m["member"], dogId=m["dogs"][0], token=token))
        require(len({e["member"] for e in pool}) == len(pool) and len({e["dogId"] for e in pool}) == len(pool), "Pool members must be distinct")
        require(len(pool) >= self.vus and len(pool) >= 54, f"Need {self.vus} distinct members, found {len(pool)}")
        print(f"PASS fixture: {len(members)} members with a dog, {len(pool)} impersonation tokens minted in {time.monotonic() - started:.0f} s "
              f"(values withheld); peak: 10 empty classes of 5 in W1 ({peak_targets[0]['date']}…{peak_targets[-1]['date']}); "
              f"burst: 10 in W0; last seat: W0 {last['date']} {last['start']}", flush=True)
        probe = pool[0]
        listed = s.call("GET", f"/api/v1/me/bookable-classes?dogId={probe['dogId']}", access=probe["token"], quiet=True)
        print(f"PASS preflight (host curl, impersonation token): /me/bookable-classes 200 with {len(listed['classes'])} rows", flush=True)

        # Peak (gated, ruling E28): 300 distinct members within 5 s of the opening. P1 before the peak: run_after waits for the
        # WEEK_OPENING run to succeed, so the N-33 fan-out is over when k6 starts (T-15-30 «while P1 fans out» stays open).
        seats = sum(c["capacity"] for c in peak_targets)
        peak_pool = [dict(e, classIds=[c["id"] for c in peak_targets]) for e in pool[:self.vus]]
        s.set_clock(opening - datetime.timedelta(seconds=20), "20 s before the opening")
        p1 = s.run_after(self.club, "WEEK_OPENING", opening)
        code, peak, output = self.run_k6("peak", peak_pool, dict(VUS=str(self.vus), ARRIVAL_SECONDS=str(self.arrival), SEATS=str(seats)))
        key = str(s.week_start + datetime.timedelta(days=13))  # opensAt + 7 days (R-15-11 openedWeekKey)
        opened = self.mongo('db.domain_events.find({clubId:' + json.dumps(self.club) + ',type:"WeekOpened","payload.openedWeekKey":' + json.dumps(key)
                            + '}).toArray().map(e=>({at:e.occurredAt,payload:e.payload}))[0]')
        n33 = self.m.wait(lambda: (lambda r: r if r and r["count"] > 0 else None)(self.mongo(
            'db.notifications.aggregate([{$match:{clubId:' + json.dumps(self.club) + ',code:"N-33"}},{$group:{_id:null,count:{$sum:1},'
            'first:{$min:"$createdAt"},last:{$max:"$createdAt"}}}]).toArray()[0]')), "N-33 rows missing")
        lag = (datetime.datetime.fromisoformat(n33["last"].replace("Z", "+00:00"))
               - datetime.datetime.fromisoformat(opened["at"].replace("Z", "+00:00"))).total_seconds()
        per_class, booking_members = self.booked([c["id"] for c in peak_targets])
        over = self.overbooked()
        print(f"RESULT peak: k6 exit {code}; {len({e['member'] for e in peak_pool})} distinct members arrived over {self.arrival} s "
              f"(iterations {self.count(peak, 'iterations')}, dropped {self.count(peak, 'dropped_iterations')}); "
              f"seats filled {sum(per_class)}/{seats} {per_class} by {booking_members} distinct members; "
              f"answers: {self.histogram(peak, output)}; seat-holds p95 {peak['http_req_duration{name:seat-holds}']['p(95)']:.0f} ms, "
              f"flow p95 {peak['flow_duration']['p(95)']:.0f} ms; overbooked classes {over}; "
              f"P1 {p1['trigger']} notified {opened['payload'].get('notified')}, {n33['count']} N-33 rows within {lag:.1f} s", flush=True)
        self.diagnostics(code)
        require(code == 0 and sum(per_class) == seats and booking_members == seats and not over and lag < 10,
                "Peak scenario failed its thresholds, the seats-filled check or the fan-out/overbooking checks")

        # Last seat (gated): 4 members fill the W0 class to capacity − 1, then 50 others hold the last seat at once.
        fillers, contenders = pool[-54:-50], pool[-50:]
        for e in fillers:
            hold = s.call("POST", "/api/v1/seat-holds", 201, access=e["token"], body=dict(classSessionId=last["id"], dogId=e["dogId"]), quiet=True)
            s.call("POST", "/api/v1/bookings", 201, access=e["token"], body=dict(seatHoldId=hold["id"]), key=hold["id"], quiet=True)
        code, seat, output = self.run_k6("last_seat", [dict(e, classIds=[last["id"]]) for e in contenders], dict(VUS="50", LAST_SEAT_CLASS=last["id"]))
        (live,), _ = self.booked([last["id"]])
        over = self.overbooked()
        print(f"RESULT last_seat: k6 exit {code}; {len({e['member'] for e in contenders})} distinct members at once; "
              f"answers: {self.histogram(seat, output)}; Mongo: {live}/{last['capacity']} live bookings; overbooked classes {over}", flush=True)
        self.diagnostics(code)
        require(code == 0 and live == last["capacity"] and not over, "Last-seat scenario failed")

        # Burst (correctness gated, latency reported): the same 300 members all at the same instant on 10 empty W0 classes
        # (W0 allows 2 bookings per dog; none of these members holds one in these classes).
        seats = sum(c["capacity"] for c in burst_targets)
        burst_pool = [dict(e, classIds=[c["id"] for c in burst_targets]) for e in pool[:self.vus]]
        code, burst, output = self.run_k6("burst", burst_pool, dict(VUS=str(self.vus), SEATS=str(seats)))
        per_class, booking_members = self.booked([c["id"] for c in burst_targets])
        over = self.overbooked()
        print(f"RESULT burst: k6 exit {code}; {len({e['member'] for e in burst_pool})} distinct members all at once; "
              f"seats filled {sum(per_class)}/{seats} {per_class} by {booking_members} distinct members; answers: {self.histogram(burst, output)}; "
              f"seat-holds p95 {burst['http_req_duration{name:seat-holds}']['p(95)']:.0f} ms, flow p95 {burst['flow_duration']['p(95)']:.0f} ms "
              f"(reported, not gated); overbooked classes {over}", flush=True)
        self.diagnostics(code)
        require(code == 0 and sum(per_class) == seats and not over, "Burst scenario failed its correctness thresholds or overbooked")
        print("PASS E5 load and concurrency (ruling E28): peak thresholds met with 300 distinct members and all 50 seats booked; "
              "last seat 1 × 201 + 49 × 409; burst correct; zero overbooking", flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--image", nargs="?", const="ghcr.io/jboixtcm/agilityhub-core-api:main",
                        help="Use the consumer Compose image instead of building; defaults to the published :main")
    parser.add_argument("--vus", type=int, default=300, help="Distinct members of the peak and burst scenarios (default 300)")
    parser.add_argument("--arrival-seconds", type=int, default=5, help="Window the peak arrivals spread over (default 5 s, ruling E28)")
    parser.add_argument("--k6", choices=["auto", "local", "docker"], default="auto", help="k6 from PATH or from the grafana/k6 image")
    options = parser.parse_args()
    k6 = options.k6 if options.k6 != "auto" else ("local" if shutil.which("k6") else "docker")
    os.umask(0o077)
    signal.signal(signal.SIGTERM, lambda number, frame: sys.exit(128 + number))
    module = load_smoke()
    with tempfile.TemporaryDirectory(prefix="agilityhub-e5-perf-") as directory:
        perf = Perf(module, Path(directory), options.image, options.vus, k6, options.arrival_seconds)
        try:
            perf.run()
        finally:
            perf.s.cleanup()


if __name__ == "__main__":
    try:
        main()
    except (AssertionError, OSError, subprocess.SubprocessError, StopIteration, KeyError, TypeError, IndexError, ValueError) as error:
        print("FAIL: " + (str(error) if isinstance(error, AssertionError) else type(error).__name__ + " " + str(error)[:160]), file=sys.stderr)
        sys.exit(1)
